// =============================================================================
// TypEase — PostgreSQL schema (Prisma ORM)
//
// Conventions
//  * Tables are snake_case (@@map); columns keep their camelCase names.
//  * Every tenant-owned table has a `tenantId` column and is protected by
//    PostgreSQL Row-Level Security (see database/migrations/0002_tenant_isolation.sql).
//  * Money is Decimal(14,2) with an ISO-4217 `currency` column. Never floats.
//  * All timestamps are timestamptz stored in UTC.
//  * "Actor" columns (createdById, decidedById ...) are soft references to
//    users.id on purpose: audit and financial history must survive user removal.
//  * Back-relation fields are added by `pnpm --filter @typease/database format`.
// =============================================================================

generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

