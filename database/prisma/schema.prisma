model Role {
  id                String             @id @default(uuid()) @db.Uuid
  /// NULL = platform-defined template role, readable by every tenant.
  tenantId          String?            @db.Uuid
  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key               String
  name              String
  description       String?
  kind              MembershipKind
  isSystem          Boolean            @default(false)
  /// Set for a company's own role (corporate portal); NULL for the centre's roles.
  corporateAccountId String?           @db.Uuid
  corporateAccount  CorporateAccount?  @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  rolePermissions   RolePermission[]
  tenantMemberships TenantMembership[]

  @@unique([tenantId, key])
  @@index([corporateAccountId])
  @@map("roles")
}

model Permission {
  key             String           @id
  groupName       String
  description     String
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String?    @db.Uuid
  tenant        Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleId        String     @db.Uuid
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionKey String
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([roleId, permissionKey])
  @@index([tenantId])
  @@map("role_permissions")
}

model TenantMembership {
  id                  String             @id @default(uuid()) @db.Uuid
  tenantId            String             @db.Uuid
  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId              String             @db.Uuid
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId              String             @db.Uuid
  role                Role               @relation(fields: [roleId], references: [id])
  kind                MembershipKind
  status              MembershipStatus   @default(ACTIVE)
  customerId          String?            @db.Uuid
  customer            Customer?          @relation(fields: [customerId], references: [id])
  corporateAccountId  String?            @db.Uuid
  corporateAccount    CorporateAccount?  @relation(fields: [corporateAccountId], references: [id])
  corporateEmployeeId String?            @db.Uuid
  corporateEmployee   CorporateEmployee? @relation(fields: [corporateEmployeeId], references: [id])
  allBranches         Boolean            @default(false)
  jobTitle            String?
  isAvailable         Boolean            @default(true)
  invitedById         String?            @db.Uuid
  invitedAt           DateTime?          @db.Timestamptz(3)
  joinedAt            DateTime?          @db.Timestamptz(3)
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(3)

  assignedRequests   ServiceRequest[]    @relation("RequestAssignee")
  reviewRequests     ServiceRequest[]    @relation("RequestReviewer")
  membershipBranches MembershipBranch[]
  staffSchedules     StaffSchedule[]
  staffSkills        StaffSkill[]
  requestAssignments RequestAssignment[]
  appointments       Appointment[]
  taskAssignments    TaskAssignment[]

  commissionEntries CommissionEntry[]

  @@unique([tenantId, userId, kind])
  @@index([userId])
  @@index([tenantId, kind, status])
  @@map("tenant_memberships")
  staffPay           StaffPay[]
  payrollLines       PayrollLine[]
}

model MembershipBranch {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String           @db.Uuid
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([tenantId, branchId])
  @@map("membership_branches")
}

model StaffSchedule {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String           @db.Uuid
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// 0 = Sunday ... 6 = Saturday
  weekday      Int
  startTime    String
  endTime      String
  isActive     Boolean          @default(true)

  @@index([tenantId, membershipId])
  @@map("staff_schedules")
}

/// Service expertise used by automatic assignment.
model StaffSkill {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId String           @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  serviceId    String           @db.Uuid
  service      Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([membershipId, serviceId])
  @@index([tenantId, serviceId])
  @@map("staff_skills")
}

model Branch {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  nameAr                 String?
  address                String?
  emirate                String?
  phone                  String?
  email                  String?
  timezone               String                  @default("Asia/Dubai")
  isHeadOffice           Boolean                 @default(false)
  isActive               Boolean                 @default(true)
  workingHours           Json                    @default("{}")
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  membershipBranches     MembershipBranch[]
  staffSchedules         StaffSchedule[]
  brandingSettings       BrandingSettings[]
  serviceBranches        ServiceBranch[]
  servicePrices          ServicePrice[]
  serviceRequests        ServiceRequest[]
  quotations             Quotation[]
  invoices               Invoice[]
  payments               Payment[]
  expenses               Expense[]
  appointmentSlotConfigs AppointmentSlotConfig[]
  branchClosures         BranchClosure[]
  appointments           Appointment[]
  cashierShifts          CashierShift[]
  queueTokens            QueueToken[]

  @@unique([tenantId, code])
  @@map("branches")
}

// ----------------------------------------------------------------------------
// Platform: SaaS billing (completely separate from customer payments)
// ----------------------------------------------------------------------------

model SubscriptionPlan {
  id                   String         @id @default(uuid()) @db.Uuid
  key                  String         @unique
  name                 String
  description          String?
  monthlyPrice         Decimal        @db.Decimal(14, 2)
  annualPrice          Decimal        @db.Decimal(14, 2)
  currency             String         @default("AED")
  trialDays            Int            @default(14)
  /// { branches, staffUsers, monthlyRequests, storageMb, aiPages, notifications, corporateClients } ; -1 = unlimited
  limits               Json
  /// { whiteLabel, customDomains, apiAccess, corporatePortal, automation, aiAssistant }
  features             Json
  isPublic             Boolean        @default(true)
  isActive             Boolean        @default(true)
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @db.Timestamptz(3)
  subscriptions        Subscription[] @relation("SubscriptionPlan")
  pendingSubscriptions Subscription[] @relation("SubscriptionPendingPlan")

  @@map("subscription_plans")
}

model Coupon {
  id             String         @id @default(uuid()) @db.Uuid
  code           String         @unique
  description    String?
  percentOff     Decimal?       @db.Decimal(5, 2)
  amountOff      Decimal?       @db.Decimal(14, 2)
  currency       String         @default("AED")
  durationMonths Int?
  maxRedemptions Int?
  redeemedCount  Int            @default(0)
  planKeys       String[]       @default([])
  validFrom      DateTime?      @db.Timestamptz(3)
  validUntil     DateTime?      @db.Timestamptz(3)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  subscriptions  Subscription[]

  @@map("coupons")
}

model Subscription {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @unique @db.Uuid
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId               String                @db.Uuid
  plan                 SubscriptionPlan      @relation("SubscriptionPlan", fields: [planId], references: [id])
  status               SubscriptionStatus
  billingCycle         BillingCycle          @default(MONTHLY)
  currentPeriodStart   DateTime              @db.Timestamptz(3)
  currentPeriodEnd     DateTime              @db.Timestamptz(3)
  trialEndsAt          DateTime?             @db.Timestamptz(3)
  graceEndsAt          DateTime?             @db.Timestamptz(3)
  cancelAtPeriodEnd    Boolean               @default(false)
  cancelledAt          DateTime?             @db.Timestamptz(3)
  cancellationReason   String?
  pendingPlanId        String?               @db.Uuid
  pendingPlan          SubscriptionPlan?     @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id])
  pendingCycle         BillingCycle?
  couponId             String?               @db.Uuid
  coupon               Coupon?               @relation(fields: [couponId], references: [id])
  couponEndsAt         DateTime?             @db.Timestamptz(3)
  gatewayCustomerRef   String?
  renewalReminderAt    DateTime?             @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  subscriptionInvoices SubscriptionInvoice[]

  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id             String                    @id @default(uuid()) @db.Uuid
  tenantId       String                    @db.Uuid
  tenant         Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String                    @db.Uuid
  subscription   Subscription              @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  number         String                    @unique
  status         SubscriptionInvoiceStatus @default(OPEN)
  reason         String                    @default("RENEWAL")
  periodStart    DateTime                  @db.Timestamptz(3)
  periodEnd      DateTime                  @db.Timestamptz(3)
  subtotal       Decimal                   @db.Decimal(14, 2)
  discount       Decimal                   @default(0) @db.Decimal(14, 2)
  tax            Decimal                   @default(0) @db.Decimal(14, 2)
  total          Decimal                   @db.Decimal(14, 2)
  currency       String                    @default("AED")
  lines          Json                      @default("[]")
  dueAt          DateTime                  @db.Timestamptz(3)
  paidAt         DateTime?                 @db.Timestamptz(3)
  paymentMethod  String?
  gatewayRef     String?
  attemptCount   Int                       @default(0)
  nextAttemptAt  DateTime?                 @db.Timestamptz(3)
  lastError      String?
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  @@index([tenantId, status])
  @@map("subscription_invoices")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptionId String   @db.Uuid
  type           String
  data           Json     @default("{}")
  actorId        String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("subscription_events")
}

model UsageRecord {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  metric    String
  /// "YYYY-MM" for monthly counters, "total" for gauges (storage, staff, branches)
  periodKey String
  quantity  Decimal  @default(0) @db.Decimal(20, 2)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, metric, periodKey])
  @@map("usage_records")
}

model TenantDomain {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @db.Uuid
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// Lower-case FQDN. Globally unique: a domain can belong to one tenant only.
  domain            String       @unique
  kind              String       @default("CUSTOM")
  app               String       @default("customer")
  verificationToken String
  status            DomainStatus @default(PENDING)
  verifiedAt        DateTime?    @db.Timestamptz(3)
  lastCheckedAt     DateTime?    @db.Timestamptz(3)
  lastCheckError    String?
  isPrimary         Boolean      @default(false)
  createdById       String?      @db.Uuid
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@map("tenant_domains")
}

model BrandingSettings {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @db.Uuid
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// NULL = tenant-wide branding. A branch row overrides selected fields.
  branchId               String?  @db.Uuid
  branch                 Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  mode                   String   @default("TYPEASE")
  businessName           String?
  businessNameAr         String?
  logoAssetKey           String?
  faviconAssetKey        String?
  primaryColor           String?
  secondaryColor         String?
  accentColor            String?
  websiteTitle           String?
  tagline                String?
  supportEmail           String?
  supportPhone           String?
  emailFromName          String?
  emailFromAddress       String?
  emailSenderVerified    Boolean  @default(false)
  invoiceFooter          String?
  receiptFooter          String?
  publicCatalogueEnabled Boolean  @default(true)
  updatedById            String?  @db.Uuid
  createdAt              DateTime @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, branchId])
  @@map("branding_settings")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  /// NULL = global default
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  payload   Json     @default("{}")
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([key, tenantId])
  @@map("feature_flags")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@map("platform_settings")
}

/// Gap-free, per-tenant document numbering (customers, requests, invoices ...).
model NumberSequence {
  id        String @id @default(uuid()) @db.Uuid
  tenantId  String @db.Uuid
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  nextValue Int    @default(1)

  @@unique([tenantId, key])
  @@map("number_sequences")
}

// ----------------------------------------------------------------------------
// Customers
// ----------------------------------------------------------------------------

model Customer {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerNo             String
  type                   CustomerType            @default(INDIVIDUAL)
  status                 CustomerStatus          @default(ACTIVE)
  fullName               String
  fullNameAr             String?
  preferredLanguage      String                  @default("en")
  email                  String?
  phone                  String?
  nationality            String?
  dateOfBirth            DateTime?               @db.Date
  address                Json?
  /// UAE TRN (15 digits) of a business customer, printed on its tax invoices.
  taxRegistrationNo      String?
  /// Identity numbers are AES-256-GCM encrypted. *Hash = keyed blind index for
  /// exact-match search and duplicate detection. *Last4 is for masked display.
  emiratesIdEnc          String?
  emiratesIdHash         String?
  emiratesIdLast4        String?
  emiratesIdExpiry       DateTime?               @db.Date
  passportNoEnc          String?
  passportNoHash         String?
  passportNoLast4        String?
  passportCountry        String?
  passportExpiry         DateTime?               @db.Date
  corporateAccountId     String?                 @db.Uuid
  corporateAccount       CorporateAccount?       @relation(fields: [corporateAccountId], references: [id])
  communicationPrefs     Json                    @default("{\"email\":true,\"sms\":true,\"whatsapp\":false,\"push\":true}")
  marketingOptIn         Boolean                 @default(false)
  mergedIntoId           String?                 @db.Uuid
  mergedInto             Customer?               @relation("CustomerMerge", fields: [mergedIntoId], references: [id])
  mergedFrom             Customer[]              @relation("CustomerMerge")
  lastActivityAt         DateTime?               @db.Timestamptz(3)
  createdById            String?                 @db.Uuid
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt              DateTime?               @db.Timestamptz(3)
  version                Int                     @default(1)
  tenantMemberships      TenantMembership[]
  customerContacts       CustomerContact[]
  customerConsents       CustomerConsent[]
  customerNotes          CustomerNote[]
  generatedDocuments     GeneratedDocument[]
  waConversations        WaConversation[]
  leads                  Lead[]
  customerTagAssignments CustomerTagAssignment[]
  corporateEmployees     CorporateEmployee[]
  serviceRequests        ServiceRequest[]
  documents              Document[]
  quotations             Quotation[]
  invoices               Invoice[]
  payments               Payment[]
  appointments           Appointment[]
  queueTokens            QueueToken[]
  reminderSchedules      ReminderSchedule[]
  supportTickets         SupportTicket[]
  customerFeedbacks      CustomerFeedback[]
  dataSubjectRequests    DataSubjectRequest[]

  @@unique([tenantId, customerNo])
  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, emiratesIdHash])
  @@index([tenantId, passportNoHash])
  @@index([tenantId, fullName])
  @@map("customers")
}

model CustomerContact {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type       String
  value      String
  label      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

/// Current consent state per customer and purpose.
model CustomerConsent {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  purpose       String
  status        ConsentStatus
  lawfulBasis   String        @default("CONSENT")
  noticeVersion String?
  grantedAt     DateTime?     @db.Timestamptz(3)
  withdrawnAt   DateTime?     @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([customerId, purpose])
  @@index([tenantId])
  @@map("customer_consents")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorId   String   @db.Uuid
  body       String
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, customerId])
  @@map("customer_notes")
}

model CustomerTag {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                   String
  color                  String?
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  customerTagAssignments CustomerTagAssignment[]

  @@unique([tenantId, name])
  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String      @db.Uuid
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tagId      String      @db.Uuid
  tag        CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([tenantId, tagId])
  @@map("customer_tag_assignments")
}

model CorporateAccount {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @db.Uuid
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  accountNo             String
  companyName           String
  companyNameAr         String?
  tradeLicenceNo        String?
  tradeLicenceAuthority String?
  tradeLicenceExpiry    DateTime?            @db.Date
  taxRegistrationNo     String?
  billingEmail          String?
  billingAddress        Json?
  paymentTermsDays      Int                  @default(0)
  creditLimit           Decimal?             @db.Decimal(14, 2)
  creditApproved        Boolean              @default(false)
  status                CorporateStatus      @default(PENDING_VERIFICATION)
  verifiedById          String?              @db.Uuid
  verifiedAt            DateTime?            @db.Timestamptz(3)
  notes                 String?
  createdAt             DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @db.Timestamptz(3)
  deletedAt             DateTime?            @db.Timestamptz(3)
  tenantMemberships     TenantMembership[]
  customers             Customer[]
  corporateMembers      CorporateMember[]
  corporateEmployees    CorporateEmployee[]
  corporateAgreements   CorporateAgreement[]
  corporatePrices       CorporatePrice[]
  serviceRequests       ServiceRequest[]
  documents             Document[]
  quotations            Quotation[]
  invoices              Invoice[]
  roles                 Role[]

  @@unique([tenantId, accountNo])
  @@index([tenantId, status])
  @@map("corporate_accounts")
}

/// A person authorised to act for the corporate account in the portal.
model CorporateMember {
  id                    String           @id @default(uuid()) @db.Uuid
  tenantId              String           @db.Uuid
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateAccountId    String           @db.Uuid
  corporateAccount      CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  userId                String?          @db.Uuid
  fullName              String
  email                 String
  phone                 String?
  role                  String           @default("ADMIN")
  isAuthorisedSignatory Boolean          @default(false)
  status                String           @default("INVITED")
  createdAt             DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([corporateAccountId, email])
  @@index([tenantId, userId])
  @@map("corporate_members")
}

model CorporateEmployee {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateAccountId String             @db.Uuid
  corporateAccount   CorporateAccount   @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  /// The customer record that owns this person's documents and requests.
  customerId         String             @db.Uuid
  customer           Customer           @relation(fields: [customerId], references: [id])
  employeeNo         String?
  designation        String?
  status             String             @default("ACTIVE")
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  tenantMemberships  TenantMembership[]

  @@unique([corporateAccountId, customerId])
  @@index([tenantId, corporateAccountId])
  @@map("corporate_employees")
}

model CorporateAgreement {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateAccountId String           @db.Uuid
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  title              String
  terms              String?
  startsOn           DateTime         @db.Date
  endsOn             DateTime?        @db.Date
  status             String           @default("ACTIVE")
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@index([tenantId, corporateAccountId])
  @@map("corporate_agreements")
}

/// Contract pricing: overrides the catalogue service fee for one company.
model CorporatePrice {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  corporateAccountId String           @db.Uuid
  corporateAccount   CorporateAccount @relation(fields: [corporateAccountId], references: [id], onDelete: Cascade)
  serviceId          String           @db.Uuid
  service            Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceFee         Decimal          @db.Decimal(14, 2)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([corporateAccountId, serviceId])
  @@index([tenantId])
  @@map("corporate_prices")
}

// ----------------------------------------------------------------------------
// Service catalogue
// ----------------------------------------------------------------------------

model ServiceCategory {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  name        String
  nameAr      String?
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  services    Service[]

  @@unique([tenantId, key])
  @@map("service_categories")
}

/// Document types a tenant works with (NULL tenant = platform defaults).
model DocumentType {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String?  @db.Uuid
  tenant          Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key             String
  name            String
  nameAr          String?
  hasExpiry       Boolean  @default(false)
  ocrProfile      String   @default("NONE")
  reminderEnabled Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, key])
  @@map("document_types")
}

model Service {
  id                       String                  @id @default(uuid()) @db.Uuid
  tenantId                 String                  @db.Uuid
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId               String                  @db.Uuid
  category                 ServiceCategory         @relation(fields: [categoryId], references: [id])
  code                     String
  name                     String
  nameAr                   String?
  description              String?
  descriptionAr            String?
  eligibilityGuidance      String?
  complianceCapability     ComplianceCapability    @default(DOCUMENT_PREPARATION_ONLY)
  estimatedProcessingHours Int?
  requiresApproval         Boolean                 @default(false)
  /// BEFORE_PROCESSING | AFTER_COMPLETION | DEPOSIT
  paymentPolicy            String                  @default("BEFORE_PROCESSING")
  depositPercent           Decimal?                @db.Decimal(5, 2)
  /// SERVICE_FEE_ONLY | ALL_COMPONENTS | NONE
  taxMode                  String                  @default("SERVICE_FEE_ONLY")
  onlineAvailable          Boolean                 @default(true)
  isPublic                 Boolean                 @default(true)
  isActive                 Boolean                 @default(true)
  allBranches              Boolean                 @default(true)
  staffGroupRoleKey        String?
  workflowDefinitionId     String?                 @db.Uuid
  workflowDefinition       WorkflowDefinition?     @relation(fields: [workflowDefinitionId], references: [id])
  /// The TypEase authority fee catalogue entry this service follows, and the version last applied to its price.
  authorityFeeId           String?                 @db.Uuid
  authorityFee             AuthorityFee?           @relation(fields: [authorityFeeId], references: [id], onDelete: SetNull)
  authorityFeeVersion      Int?
  sortOrder                Int                     @default(0)
  createdAt                DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt                DateTime?               @db.Timestamptz(3)
  version                  Int                     @default(1)
  staffSkills              StaffSkill[]
  corporatePrices          CorporatePrice[]
  serviceBranches          ServiceBranch[]
  servicePrices            ServicePrice[]
  serviceRequirements      ServiceRequirement[]
  serviceFormDefinitions   ServiceFormDefinition[]
  serviceRequests          ServiceRequest[]
  appointments             Appointment[]

  commissionRules CommissionRule[]

  @@unique([tenantId, code])
  @@index([tenantId, categoryId])
  @@index([tenantId, isActive, isPublic])
  @@index([tenantId, authorityFeeId])
  @@map("services")
}

/// Platform-wide catalogue of authority fees maintained by TypEase (migration 0009). Read by every centre.
model AuthorityFee {
  id            String               @id @default(uuid()) @db.Uuid
  /// AMER | TASHEEL | ICP | MOHRE | DED | MOFA | DHA | OTHER
  authority     String
  code          String               @unique
  name          String
  nameAr        String?
  category      String?
  governmentFee Decimal              @default(0) @db.Decimal(14, 2)
  thirdPartyFee Decimal              @default(0) @db.Decimal(14, 2)
  notes         String?
  sourceUrl     String?
  verifiedAt    DateTime?            @db.Date
  /// Sample amounts entered by TypEase for illustration: centres must verify them.
  isSample      Boolean              @default(true)
  isActive      Boolean              @default(true)
  version       Int                  @default(1)
  updatedById   String?              @db.Uuid
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  changes       AuthorityFeeChange[]
  services      Service[]

  @@index([authority, isActive])
  @@map("authority_fees")
}

model AuthorityFeeChange {
  id                  String       @id @default(uuid()) @db.Uuid
  feeId               String       @db.Uuid
  fee                 AuthorityFee @relation(fields: [feeId], references: [id], onDelete: Cascade)
  version             Int
  governmentFeeBefore Decimal      @db.Decimal(14, 2)
  governmentFeeAfter  Decimal      @db.Decimal(14, 2)
  thirdPartyFeeBefore Decimal      @db.Decimal(14, 2)
  thirdPartyFeeAfter  Decimal      @db.Decimal(14, 2)
  note                String?
  changedById         String?      @db.Uuid
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)

  @@unique([feeId, version])
  @@map("authority_fee_changes")
}

model ServiceBranch {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branchId  String  @db.Uuid
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([serviceId, branchId])
  @@index([tenantId, branchId])
  @@map("service_branches")
}

model ServicePrice {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId             String    @db.Uuid
  service               Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// NULL = default price for all branches
  branchId              String?   @db.Uuid
  branch                Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceFee            Decimal   @db.Decimal(14, 2)
  governmentFeeEstimate Decimal   @default(0) @db.Decimal(14, 2)
  thirdPartyFeeEstimate Decimal   @default(0) @db.Decimal(14, 2)
  currency              String    @default("AED")
  validFrom             DateTime  @default(now()) @db.Timestamptz(3)
  validTo               DateTime? @db.Timestamptz(3)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, serviceId, isActive])
  @@map("service_prices")
}

model ServiceRequirement {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId       String   @db.Uuid
  service         Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  documentTypeKey String
  label           String
  labelAr         String?
  description     String?
  isMandatory     Boolean  @default(true)
  /// May a valid document already on the customer's file satisfy this item?
  allowReuse      Boolean  @default(true)
  maxAgeDays      Int?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, serviceId])
  @@map("service_requirements")
}

/// Versioned dynamic form. `schema` = { steps: [{ key, title, fields: [...] }] }
model ServiceFormDefinition {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId   String        @db.Uuid
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  version     Int           @default(1)
  status      PublishStatus @default(DRAFT)
  schema      Json
  publishedAt DateTime?     @db.Timestamptz(3)
  createdById String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)

  @@unique([serviceId, version])
  @@index([tenantId, serviceId, status])
  @@map("service_form_definitions")
}

model WorkflowDefinition {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key                String
  name               String
  description        String?
  templateKey        String?
  /// Soft reference to the currently published WorkflowVersion.
  publishedVersionId String?           @db.Uuid
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)
  services           Service[]
  workflowVersions   WorkflowVersion[]

  @@unique([tenantId, key])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definitionId       String              @db.Uuid
  definition         WorkflowDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version            Int
  status             PublishStatus       @default(DRAFT)
  notes              String?
  publishedAt        DateTime?           @db.Timestamptz(3)
  publishedById      String?             @db.Uuid
  createdById        String?             @db.Uuid
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  workflowSteps      WorkflowStep[]
  workflowExecutions WorkflowExecution[]

  @@unique([definitionId, version])
  @@index([tenantId, definitionId, status])
  @@map("workflow_versions")
}

model WorkflowStep {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versionId         String           @db.Uuid
  version           WorkflowVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  key               String
  name              String
  nameAr            String?
  type              WorkflowStepType
  position          Int
  config            Json             @default("{}")
  /// Optional rule: { all: [{ fact, op, value }] }. Step is skipped when false.
  conditions        Json?
  /// For CONDITIONAL_BRANCH: [{ when: {...}, goTo: stepKey }], plus defaultNextKey
  branches          Json?
  nextStepKey       String?
  onRejectStepKey   String?
  assigneeRoleKey   String?
  timeoutHours      Int?
  escalateToRoleKey String?
  customerVisible   Boolean          @default(true)

  @@unique([versionId, key])
  @@index([tenantId, versionId, position])
  @@map("workflow_steps")
}

// ----------------------------------------------------------------------------
// Service requests (cases)
// ----------------------------------------------------------------------------

model ServiceRequest {
  id                        String                     @id @default(uuid()) @db.Uuid
  tenantId                  String                     @db.Uuid
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId                  String                     @db.Uuid
  branch                    Branch                     @relation(fields: [branchId], references: [id])
  requestNo                 String
  customerId                String                     @db.Uuid
  customer                  Customer                   @relation(fields: [customerId], references: [id])
  corporateAccountId        String?                    @db.Uuid
  corporateAccount          CorporateAccount?          @relation(fields: [corporateAccountId], references: [id])
  serviceId                 String                     @db.Uuid
  service                   Service                    @relation(fields: [serviceId], references: [id])
  /// Frozen copy of name / code / compliance capability / payment policy.
  serviceSnapshot           Json                       @default("{}")
  status                    RequestStatus              @default(DRAFT)
  priority                  RequestPriority            @default(NORMAL)
  source                    RequestSource              @default(WALK_IN)
  paymentStatus             RequestPaymentStatus       @default(UNPAID)
  assignedToId              String?                    @db.Uuid
  assignedTo                TenantMembership?          @relation("RequestAssignee", fields: [assignedToId], references: [id])
  reviewerId                String?                    @db.Uuid
  reviewer                  TenantMembership?          @relation("RequestReviewer", fields: [reviewerId], references: [id])
  customerInstructions      String?
  submittedAt               DateTime?                  @db.Timestamptz(3)
  targetDate                DateTime?                  @db.Timestamptz(3)
  completedAt               DateTime?                  @db.Timestamptz(3)
  cancelledAt               DateTime?                  @db.Timestamptz(3)
  cancellationReason        String?
  submissionChannel         SubmissionChannel?
  /// Free-text status reported by an authority / partner. Always labelled
  /// with its source; never presented as an official status unless verified.
  externalStatus            String?
  externalStatusSource      StatusSource?
  externalStatusAt          DateTime?                  @db.Timestamptz(3)
  formDefinitionId          String?                    @db.Uuid
  workflowVersionId         String?                    @db.Uuid
  duplicateOfId             String?                    @db.Uuid
  duplicateOf               ServiceRequest?            @relation("RequestDuplicate", fields: [duplicateOfId], references: [id])
  duplicates                ServiceRequest[]           @relation("RequestDuplicate")
  renewalOfDocumentId       String?                    @db.Uuid
  reopenedCount             Int                        @default(0)
  /// SHA-256 of the public tracking code (shown once to the customer).
  trackingCodeHash          String?
  createdById               String?                    @db.Uuid
  createdByType             ActorType                  @default(STAFF)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  deletedAt                 DateTime?                  @db.Timestamptz(3)
  version                   Int                        @default(1)
  requestFields             RequestField[]
  requestDocuments          RequestDocument[]
  requestStatusHistories    RequestStatusHistory[]
  requestAssignments        RequestAssignment[]
  requestApprovals          RequestApproval[]
  requestComments           RequestComment[]
  requestExternalReferences RequestExternalReference[]
  workflowExecution         WorkflowExecution?
  documents                 Document[]
  quotations                Quotation[]
  invoices                  Invoice[]
  tasks                     Task[]
  supportTickets            SupportTicket[]

  commissionEntries CommissionEntry[]

  @@unique([tenantId, requestNo])
  @@index([tenantId, status])
  @@index([tenantId, branchId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, corporateAccountId])
  @@index([tenantId, createdAt])
  @@index([tenantId, targetDate])
  @@map("service_requests")
}

model RequestField {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @db.Uuid
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId String         @db.Uuid
  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  /// CUSTOMER | STAFF | PREFILL | OCR
  source    String         @default("STAFF")
  verified  Boolean        @default(false)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([requestId, key])
  @@index([tenantId])
  @@map("request_fields")
}

/// Document checklist line for a request (inputs and completion documents).
model RequestDocument {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @db.Uuid
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId       String          @db.Uuid
  request         ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requirementId   String?         @db.Uuid
  documentTypeKey String
  label           String
  labelAr         String?
  /// INPUT | COMPLETION
  kind            String          @default("INPUT")
  isMandatory     Boolean         @default(true)
  documentId      String?         @db.Uuid
  document        Document?       @relation(fields: [documentId], references: [id])
  status          ChecklistStatus @default(MISSING)
  rejectionReason String?
  reviewedById    String?         @db.Uuid
  reviewedAt      DateTime?       @db.Timestamptz(3)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([tenantId, requestId])
  @@index([tenantId, documentId])
  @@map("request_documents")
}

/// Append-only. Every status change goes through the state machine and lands here.
model RequestStatusHistory {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId       String         @db.Uuid
  request         ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus      RequestStatus?
  toStatus        RequestStatus
  actorId         String?        @db.Uuid
  actorType       ActorType
  reason          String?
  customerVisible Boolean        @default(true)
  customerMessage String?
  meta            Json           @default("{}")
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, requestId, createdAt])
  @@map("request_status_history")
}

model RequestAssignment {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId    String           @db.Uuid
  request      ServiceRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assigneeId   String           @db.Uuid
  assignee     TenantMembership @relation(fields: [assigneeId], references: [id])
  /// OPERATOR | REVIEWER
  role         String           @default("OPERATOR")
  /// MANUAL | AUTO
  method       String           @default("MANUAL")
  reason       String?
  assignedById String?          @db.Uuid
  assignedAt   DateTime         @default(now()) @db.Timestamptz(3)
  unassignedAt DateTime?        @db.Timestamptz(3)

  @@index([tenantId, requestId])
  @@index([tenantId, assigneeId, unassignedAt])
  @@map("request_assignments")
}

model RequestApproval {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @db.Uuid
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId     String         @db.Uuid
  request       ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// REVIEW | FINAL_REVIEW | CORPORATE | CUSTOMER | DISCOUNT
  type          String
  status        ApprovalStatus @default(PENDING)
  stepKey       String?
  requestedById String?        @db.Uuid
  decidedById   String?        @db.Uuid
  decidedAt     DateTime?      @db.Timestamptz(3)
  comment       String?
  payload       Json           @default("{}")
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, requestId])
  @@index([tenantId, status, type])
  @@map("request_approvals")
}

model RequestComment {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId  String         @db.Uuid
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId   String?        @db.Uuid
  authorType ActorType
  authorName String?
  body       String
  visibility Visibility     @default(INTERNAL)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)

  @@index([tenantId, requestId, createdAt])
  @@map("request_comments")
}

model RequestExternalReference {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId        String            @db.Uuid
  request          ServiceRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  channel          SubmissionChannel
  authorityName    String?
  referenceNo      String
  partnerName      String?
  partnerReference String?
  status           String?
  statusSource     StatusSource      @default(STAFF_ENTERED)
  integrationId    String?           @db.Uuid
  notes            String?
  recordedById     String?           @db.Uuid
  recordedAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, requestId])
  @@index([tenantId, referenceNo])
  @@map("request_external_references")
}

model WorkflowExecution {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @db.Uuid
  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestId              String                  @unique @db.Uuid
  request                ServiceRequest          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  versionId              String                  @db.Uuid
  version                WorkflowVersion         @relation(fields: [versionId], references: [id])
  status                 ExecutionStatus         @default(ACTIVE)
  currentStepKey         String?
  migratedFromVersionId  String?                 @db.Uuid
  startedAt              DateTime                @default(now()) @db.Timestamptz(3)
  completedAt            DateTime?               @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
  workflowStepExecutions WorkflowStepExecution[]

  @@index([tenantId, status])
  @@map("workflow_executions")
}

model WorkflowStepExecution {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @db.Uuid
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executionId String            @db.Uuid
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepKey     String
  stepName    String
  stepType    WorkflowStepType
  status      StepStatus        @default(PENDING)
  attempt     Int               @default(1)
  startedAt   DateTime?         @db.Timestamptz(3)
  completedAt DateTime?         @db.Timestamptz(3)
  dueAt       DateTime?         @db.Timestamptz(3)
  escalatedAt DateTime?         @db.Timestamptz(3)
  actorId     String?           @db.Uuid
  result      Json              @default("{}")
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, executionId])
  @@index([status, dueAt])
  @@map("workflow_step_executions")
}

// ----------------------------------------------------------------------------
// Documents
// ----------------------------------------------------------------------------

model Document {
  id                          String                       @id @default(uuid()) @db.Uuid
  tenantId                    String                       @db.Uuid
  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId                  String?                      @db.Uuid
  customer                    Customer?                    @relation(fields: [customerId], references: [id])
  corporateAccountId          String?                      @db.Uuid
  corporateAccount            CorporateAccount?            @relation(fields: [corporateAccountId], references: [id])
  requestId                   String?                      @db.Uuid
  request                     ServiceRequest?              @relation(fields: [requestId], references: [id])
  documentTypeKey             String
  category                    String?
  title                       String
  /// Soft reference to the active DocumentVersion.
  currentVersionId            String?                      @db.Uuid
  status                      DocumentStatus               @default(PENDING_UPLOAD)
  verificationStatus          VerificationStatus           @default(UNVERIFIED)
  verifiedById                String?                      @db.Uuid
  verifiedAt                  DateTime?                    @db.Timestamptz(3)
  issuedDate                  DateTime?                    @db.Date
  expiryDate                  DateTime?                    @db.Date
  expiryVerified              Boolean                      @default(false)
  isCompletionDocument        Boolean                      @default(false)
  customerVisible             Boolean                      @default(true)
  legalHold                   Boolean                      @default(false)
  retentionUntil              DateTime?                    @db.Timestamptz(3)
  uploadedById                String?                      @db.Uuid
  uploadedByType              ActorType                    @default(STAFF)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  deletedAt                   DateTime?                    @db.Timestamptz(3)
  deletedById                 String?                      @db.Uuid
  purgeAfter                  DateTime?                    @db.Timestamptz(3)
  requestDocuments            RequestDocument[]
  documentVersions            DocumentVersion[]
  documentShares              DocumentShare[]
  documentVerificationResults DocumentVerificationResult[]
  ocrExtractionResults        OcrExtractionResult[]
  reminderSchedules           ReminderSchedule[]

  @@index([tenantId, customerId])
  @@index([tenantId, requestId])
  @@index([tenantId, corporateAccountId])
  @@index([tenantId, expiryDate])
  @@index([tenantId, status])
  @@map("documents")
}

model DocumentVersion {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId       String     @db.Uuid
  document         Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNo        Int
  /// Random, unguessable object key. Never derived from user input.
  storageKey       String     @unique
  originalFilename String
  declaredMime     String
  detectedMime     String?
  sizeBytes        BigInt     @default(0)
  sha256           String?
  /// NONE | SSE_S3 | APP_AES256_GCM
  encryption       String     @default("NONE")
  encryptionMeta   Json?
  /// PENDING | COMPLETED | FAILED
  uploadStatus     String     @default("PENDING")
  uploadExpiresAt  DateTime?  @db.Timestamptz(3)
  scanStatus       ScanStatus @default(PENDING)
  scanEngine       String?
  scanDetail       String?
  scannedAt        DateTime?  @db.Timestamptz(3)
  uploadedById     String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)

  @@unique([documentId, versionNo])
  @@index([tenantId, documentId])
  @@map("document_versions")
}

/// Append-only access trail for every view, link, download and share.
model DocumentAccessLog {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId     String    @db.Uuid
  versionId      String?   @db.Uuid
  actorId        String?   @db.Uuid
  actorType      ActorType
  action         String
  supportGrantId String?   @db.Uuid
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, documentId, createdAt])
  @@map("document_access_logs")
}

model DocumentShare {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId    String    @db.Uuid
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  recipient     String?
  expiresAt     DateTime  @db.Timestamptz(3)
  maxDownloads  Int       @default(3)
  downloadCount Int       @default(0)
  revokedAt     DateTime? @db.Timestamptz(3)
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, documentId])
  @@map("document_shares")
}

model DocumentVerificationResult {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId      String   @db.Uuid
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId       String?  @db.Uuid
  reviewerId      String   @db.Uuid
  /// APPROVED | REJECTED | CORRECTION_REQUESTED
  decision        String
  reason          String?
  fieldsConfirmed Json     @default("{}")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, documentId])
  @@map("document_verification_results")
}

/// AI / OCR output. Always unverified until a human review is recorded.
model OcrExtractionResult {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @db.Uuid
  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId               String    @db.Uuid
  document                 Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId                String    @db.Uuid
  provider                 String
  profile                  String
  status                   OcrStatus @default(QUEUED)
  classification           String?
  classificationConfidence Decimal?  @db.Decimal(4, 3)
  /// [{ key, value, confidence, source }]
  fields                   Json      @default("[]")
  /// [{ code, severity, message, field }]
  warnings                 Json      @default("[]")
  pages                    Int       @default(0)
  costUnits                Decimal   @default(0) @db.Decimal(12, 4)
  error                    String?
  requestedById            String?   @db.Uuid
  reviewedById             String?   @db.Uuid
  reviewedAt               DateTime? @db.Timestamptz(3)
  reviewedFields           Json?
  createdAt                DateTime  @default(now()) @db.Timestamptz(3)
  completedAt              DateTime? @db.Timestamptz(3)

  @@index([tenantId, documentId])
  @@index([tenantId, status])
  @@map("ocr_extraction_results")
}

model AiUsageLog {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider     String
  operation    String
  documentId   String?  @db.Uuid
  pages        Int      @default(0)
  units        Decimal  @default(0) @db.Decimal(12, 4)
  costEstimate Decimal  @default(0) @db.Decimal(14, 4)
  currency     String   @default("USD")
  actorId      String?  @db.Uuid
  success      Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("ai_usage_logs")
}

// ----------------------------------------------------------------------------
// Finance (customer-facing; unrelated to SaaS subscription billing)
// ----------------------------------------------------------------------------

/// How each fee component is treated for reporting. Government and third-party
/// fees default to PASS_THROUGH_LIABILITY and are never counted as revenue.
model FeeComponent {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type       FeeComponentType
  name       String
  treatment  AccountingTreatment
  taxable    Boolean             @default(false)
  ledgerCode String?
  reviewNote String?
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, type])
  @@map("fee_components")
}

model Quotation {
  id                    String            @id @default(uuid()) @db.Uuid
  tenantId              String            @db.Uuid
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId              String            @db.Uuid
  branch                Branch            @relation(fields: [branchId], references: [id])
  quotationNo           String
  requestId             String?           @db.Uuid
  request               ServiceRequest?   @relation(fields: [requestId], references: [id])
  customerId            String            @db.Uuid
  customer              Customer          @relation(fields: [customerId], references: [id])
  corporateAccountId    String?           @db.Uuid
  corporateAccount      CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  status                QuotationStatus   @default(DRAFT)
  currency              String            @default("AED")
  subtotalServiceFee    Decimal           @default(0) @db.Decimal(14, 2)
  subtotalGovernmentFee Decimal           @default(0) @db.Decimal(14, 2)
  subtotalThirdParty    Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal           @default(0) @db.Decimal(14, 2)
  total                 Decimal           @default(0) @db.Decimal(14, 2)
  validUntil            DateTime?         @db.Timestamptz(3)
  notes                 String?
  /// NONE | PENDING | APPROVED | REJECTED
  discountApproval      String            @default("NONE")
  discountRequestedById String?           @db.Uuid
  discountDecidedById   String?           @db.Uuid
  discountReason        String?
  sentAt                DateTime?         @db.Timestamptz(3)
  decidedAt             DateTime?         @db.Timestamptz(3)
  decidedById           String?           @db.Uuid
  decidedByType         ActorType?
  rejectionReason       String?
  createdById           String?           @db.Uuid
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)
  version               Int               @default(1)
  quotationItems        QuotationItem[]
  invoices              Invoice[]

  @@unique([tenantId, quotationNo])
  @@index([tenantId, requestId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("quotations")
}

model QuotationItem {
  id             String           @id @default(uuid()) @db.Uuid
