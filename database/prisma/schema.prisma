  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  platform   String
  token      String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, token])
  @@index([tenantId, userId])
  @@map("device_tokens")
}

model ReminderSchedule {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @db.Uuid
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String?            @db.Uuid
  customer           Customer?          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  corporateAccountId String?            @db.Uuid
  documentId         String?            @db.Uuid
  document           Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  documentTypeKey    String
  subjectLabel       String
  expiryDate         DateTime           @db.Date
  offsetsDays        Int[]              @default([90, 60, 30, 15, 7])
  status             ReminderStatus     @default(ACTIVE)
  renewalRequestId   String?            @db.Uuid
  createdById        String?            @db.Uuid
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  reminderDispatches ReminderDispatch[]

  @@index([tenantId, status, expiryDate])
  @@index([tenantId, customerId])
  @@index([tenantId, documentId])
  @@map("reminder_schedules")
}

model ReminderDispatch {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @db.Uuid
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  scheduleId     String           @db.Uuid
  schedule       ReminderSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  offsetDays     Int
  dueOn          DateTime         @db.Date
  /// PENDING | SENT | SKIPPED_NO_CONSENT | SKIPPED_OPT_OUT | FAILED | CANCELLED
  status         String           @default("PENDING")
  notificationId String?          @db.Uuid
  detail         String?
  processedAt    DateTime?        @db.Timestamptz(3)

  @@unique([scheduleId, offsetDays])
  @@index([tenantId, status, dueOn])
  @@map("reminder_dispatches")
}

model SlaPolicy {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @db.Uuid
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  priority             RequestPriority
  firstResponseMinutes Int
  resolutionMinutes    Int
  isActive             Boolean         @default(true)

  @@unique([tenantId, priority])
  @@map("sla_policies")
}

model SupportTicket {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketNo           String
  /// CUSTOMER = customer -> centre ; PLATFORM = centre -> TypEase support
  scope              String           @default("CUSTOMER")
  customerId         String?          @db.Uuid
  customer           Customer?        @relation(fields: [customerId], references: [id])
  requestId          String?          @db.Uuid
  request            ServiceRequest?  @relation(fields: [requestId], references: [id])
  raisedByUserId     String?          @db.Uuid
  subject            String
  category           String?
  priority           RequestPriority  @default(NORMAL)
  status             TicketStatus     @default(OPEN)
  assigneeId         String?          @db.Uuid
  platformAssigneeId String?          @db.Uuid
  firstResponseDueAt DateTime?        @db.Timestamptz(3)
  resolutionDueAt    DateTime?        @db.Timestamptz(3)
  firstRespondedAt   DateTime?        @db.Timestamptz(3)
  resolvedAt         DateTime?        @db.Timestamptz(3)
  closedAt           DateTime?        @db.Timestamptz(3)
  resolutionSummary  String?
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)
  supportMessages    SupportMessage[]

  @@unique([tenantId, ticketNo])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([scope, status])
  @@map("support_tickets")
}

model SupportMessage {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticketId     String        @db.Uuid
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String?       @db.Uuid
  authorType   ActorType
  authorName   String?
  body         String
  visibility   Visibility    @default(CUSTOMER)
  /// Document ids attached to the message.
  attachments  String[]      @default([])
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, ticketId, createdAt])
  @@map("support_messages")
}

model CustomerFeedback {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestId  String?  @db.Uuid
  ticketId   String?  @db.Uuid
  rating     Int
  comment    String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@map("customer_feedback")
}

// ----------------------------------------------------------------------------
// Automation
// ----------------------------------------------------------------------------

/// Transactional outbox: domain events are written in the same transaction as
/// the change that caused them and dispatched by the worker.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String?      @db.Uuid
  type        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @db.Timestamptz(3)
  processedAt DateTime?    @db.Timestamptz(3)
  error       String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([tenantId, type, createdAt])
  @@map("outbox_events")
}

model AutomationRule {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                 String
  description          String?
  templateKey          String?
  triggerEvent         String
  /// { all: [{ fact, op, value }] }
  conditions           Json                  @default("{}")
  /// [{ type, config }]
  actions              Json                  @default("[]")
  isEnabled            Boolean               @default(false)
  maxRetries           Int                   @default(3)
  createdById          String?               @db.Uuid
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  automationExecutions AutomationExecution[]

  @@index([tenantId, triggerEvent, isEnabled])
  @@map("automation_rules")
}

model AutomationExecution {
  id            String                    @id @default(uuid()) @db.Uuid
  tenantId      String                    @db.Uuid
  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId        String                    @db.Uuid
  rule          AutomationRule            @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventId       String                    @db.Uuid
  eventType     String
  status        AutomationExecutionStatus @default(PENDING)
  attempts      Int                       @default(0)
  actionResults Json                      @default("[]")
  error         String?
  startedAt     DateTime?                 @db.Timestamptz(3)
  finishedAt    DateTime?                 @db.Timestamptz(3)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)

  /// Idempotency: one execution per (rule, event).
  @@unique([ruleId, eventId])
  @@index([tenantId, status, createdAt])
  @@map("automation_executions")
}

model ScheduledReport {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reportKey   String
  params      Json      @default("{}")
  /// XLSX | PDF
  format      String    @default("XLSX")
  /// DAILY | WEEKLY | MONTHLY
  frequency   String
  recipients  String[]
  isActive    Boolean   @default(true)
  nextRunAt   DateTime  @db.Timestamptz(3)
  lastRunAt   DateTime? @db.Timestamptz(3)
  lastStatus  String?
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([isActive, nextRunAt])
  @@index([tenantId])
  @@map("scheduled_reports")
}

// ----------------------------------------------------------------------------
// Security, privacy and integrations
// ----------------------------------------------------------------------------

/// Append-only (enforced by trigger).
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @db.Uuid
  actorUserId    String?   @db.Uuid
  actorType      ActorType
  actorLabel     String?
  action         String
  resourceType   String
  resourceId     String?
  summary        String?
  before         Json?
  after          Json?
  supportGrantId String?   @db.Uuid
  requestId      String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, resourceType, resourceId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  userId    String?  @db.Uuid
  type      String
  /// INFO | LOW | MEDIUM | HIGH | CRITICAL
  severity  String   @default("LOW")
  details   Json     @default("{}")
  ip        String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([type, createdAt])
  @@map("security_events")
}

/// Explicit, time-limited permission for platform staff to enter a tenant.
model AccessGrant {
  id              String            @id @default(uuid()) @db.Uuid
  tenantId        String            @db.Uuid
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedById   String            @db.Uuid
  reason          String
  /// Permission keys the grant unlocks, e.g. ["request.read.all"]. Document
  /// content requires the explicit "document.read" scope.
  scopes          String[]
  ticketId        String?           @db.Uuid
  status          AccessGrantStatus @default(REQUESTED)
  durationMinutes Int               @default(60)
  decidedById     String?           @db.Uuid
  decidedAt       DateTime?         @db.Timestamptz(3)
  decisionNote    String?
  startsAt        DateTime?         @db.Timestamptz(3)
  expiresAt       DateTime?         @db.Timestamptz(3)
  revokedAt       DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([requestedById, status])
  @@map("access_grants")
}

/// Immutable history of every consent decision (append-only).
model ConsentRecord {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId    String?       @db.Uuid
  userId        String?       @db.Uuid
  purpose       String
  status        ConsentStatus
  lawfulBasis   String        @default("CONSENT")
  noticeVersion String?
  /// PORTAL | MOBILE | STAFF_RECORDED | IMPORT
  capturedVia   String
  capturedById  String?       @db.Uuid
  ip            String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, customerId, purpose])
  @@map("consent_records")
}

model DataRetentionPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// DOCUMENT | CUSTOMER | NOTIFICATION | SUPPORT_TICKET
  entity          String
  documentTypeKey String?
  retainDays      Int
  /// DELETE | ANONYMISE
  action          String   @default("DELETE")
  legalBasisNote  String?
  isActive        Boolean  @default(true)
  updatedById     String?  @db.Uuid
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, entity, documentTypeKey])
  @@map("data_retention_policies")
}

/// Privacy requests: access, correction, deletion, export.
model DataSubjectRequest {
  id                 String            @id @default(uuid()) @db.Uuid
  tenantId           String            @db.Uuid
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId         String            @db.Uuid
  customer           Customer          @relation(fields: [customerId], references: [id])
  requestedByUserId  String?           @db.Uuid
  type               DataRequestType
  status             DataRequestStatus @default(RECEIVED)
  details            String?
  decisionNote       String?
  /// Why some data must be kept (e.g. statutory record keeping).
  retentionException String?
  handledById        String?           @db.Uuid
  exportDocumentId   String?           @db.Uuid
  dueAt              DateTime?         @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(3)

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@map("data_subject_requests")
}

model SecurityIncident {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String?   @db.Uuid
  title                 String
  description           String
  severity              String    @default("MEDIUM")
  /// OPEN | INVESTIGATING | CONTAINED | RESOLVED
  status                String    @default("OPEN")
  affectedData          String?
  personalDataInvolved  Boolean   @default(false)
  notificationRequired  Boolean?
  authorityNotifiedAt   DateTime? @db.Timestamptz(3)
  individualsNotifiedAt DateTime? @db.Timestamptz(3)
  resolutionNotes       String?
  detectedAt            DateTime  @default(now()) @db.Timestamptz(3)
  resolvedAt            DateTime? @db.Timestamptz(3)
  reportedById          String?   @db.Uuid
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([tenantId, status])
  @@map("security_incidents")
}

/// Register of vendors / processors and cross-border transfer review.
model ProcessorRecord {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String?   @db.Uuid
  name           String
  purpose        String
  dataCategories String[]
  country        String
  crossBorder    Boolean   @default(false)
  safeguards     String?
  /// PENDING_REVIEW | APPROVED | REJECTED
  status         String    @default("PENDING_REVIEW")
  reviewedById   String?   @db.Uuid
  reviewedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([tenantId])
  @@map("processor_records")
}

/// Integration configuration + credential metadata. Secrets are stored only as
/// an AES-256-GCM envelope (`secretsEnc`); they are never returned by the API.
model Integration {
  id                        String            @id @default(uuid()) @db.Uuid
  /// NULL = platform-level integration
  tenantId                  String?           @db.Uuid
  tenant                    Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// PAYMENT | EMAIL | SMS | WHATSAPP | PUSH | OCR | MALWARE_SCAN | GOVERNMENT | PARTNER | AUTOMATION
  category                  String
  provider                  String
  name                      String
  status                    IntegrationStatus @default(DISABLED)
  mode                      String            @default("TEST")
  config                    Json              @default("{}")
  secretsEnc                String?
  secretKeys                String[]          @default([])
  secretsUpdatedAt          DateTime?         @db.Timestamptz(3)
  /// For GOVERNMENT / PARTNER: evidence that the centre is authorised.
  authorisationNote         String?
  authorisationVerifiedById String?           @db.Uuid
  authorisationVerifiedAt   DateTime?         @db.Timestamptz(3)
  lastTestedAt              DateTime?         @db.Timestamptz(3)
  lastTestOk                Boolean?
  lastTestMessage           String?
  createdById               String?           @db.Uuid
  createdAt                 DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, category, provider])
  @@map("integration_credentials_metadata")
}

model IntegrationLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integrationId String?  @db.Uuid
  category      String
  provider      String
  operation     String
  /// OUTBOUND | INBOUND
  direction     String   @default("OUTBOUND")
  success       Boolean
  statusCode    Int?
  durationMs    Int?
  /// Redacted summaries only. Never raw documents or secrets.
  request       Json?
  response      Json?
  error         String?
  relatedType   String?
  relatedId     String?  @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, category, provider])
  @@map("integration_logs")
}

/// A cashier's till session: opened with a float, closed with a count. Counter payments,
/// cash refunds and cash expenses taken while it is open are linked to it.
model CashierShift {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @db.Uuid
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId      String             @db.Uuid
  branch        Branch             @relation(fields: [branchId], references: [id])
  shiftNo       String
  currency      String             @default("AED")
  status        CashierShiftStatus @default(OPEN)
  openedById    String             @db.Uuid
  openedByName  String
  openedAt      DateTime           @default(now()) @db.Timestamptz(3)
  openingFloat  Decimal            @default(0) @db.Decimal(14, 2)
  openingNote   String?
  closedById    String?            @db.Uuid
  closedAt      DateTime?          @db.Timestamptz(3)
  /// Snapshot at closing: totals per method, cash in/out and the expected cash in the drawer.
  expected      Json?
  countedCash   Decimal?           @db.Decimal(14, 2)
  countedCard   Decimal?           @db.Decimal(14, 2)
  cashVariance  Decimal?           @db.Decimal(14, 2)
  cardVariance  Decimal?           @db.Decimal(14, 2)
  /// { "1000": 2, "500": 1, ... } note / coin counts, as entered
  denominations Json?
  closingNote   String?
  reviewedById  String?            @db.Uuid
  reviewedAt    DateTime?          @db.Timestamptz(3)
  reviewNote    String?
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  payments      Payment[]
  refunds       Refund[]
  expenses      Expense[]

  @@unique([tenantId, shiftNo])
  @@index([tenantId, branchId, openedAt])
  @@index([tenantId, status])
  @@map("cashier_shifts")
}

/// A payment reminder sent for an unpaid invoice: automatic stages (days from the due date) are sent once each.
model InvoiceReminder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Days from the due date this stage belongs to (negative = before it). Null for a manual reminder.
  stage       Int?
  daysOverdue Int
  automatic   Boolean  @default(true)
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @default("AED")
  sentById    String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, invoiceId])
  @@index([tenantId, createdAt])
  @@map("invoice_reminders")
}

/// How much a staff member earns for a completed request: a percentage of the service fee or a fixed amount,
/// for one service or (serviceId null) as the default for all services.
model CommissionRule {
  id          String                @id @default(uuid()) @db.Uuid
  tenantId    String                @db.Uuid
  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceId   String?               @db.Uuid
  service     Service?              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  beneficiary CommissionBeneficiary
  kind        CommissionKind
  value       Decimal               @db.Decimal(10, 2)
  isActive    Boolean               @default(true)
  createdById String                @db.Uuid
  createdAt   DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime              @updatedAt @db.Timestamptz(3)
  entries     CommissionEntry[]

  @@index([tenantId, serviceId])
  @@map("commission_rules")
}

/// Commission earned by one person on one completed request, until it is paid out.
model CommissionEntry {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String                @db.Uuid
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ruleId       String                @db.Uuid
  rule         CommissionRule        @relation(fields: [ruleId], references: [id])
  requestId    String                @db.Uuid
  request      ServiceRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  serviceId    String                @db.Uuid
  membershipId String                @db.Uuid
  membership   TenantMembership      @relation(fields: [membershipId], references: [id])
  userId       String                @db.Uuid
  beneficiary  CommissionBeneficiary
  /// Service fee (net of discounts, without VAT) the percentage was applied to.
  basis        Decimal               @db.Decimal(14, 2)
  kind         CommissionKind
  value        Decimal               @db.Decimal(10, 2)
  amount       Decimal               @db.Decimal(14, 2)
  currency     String                @default("AED")
  status       CommissionEntryStatus @default(ACCRUED)
  earnedAt     DateTime              @default(now()) @db.Timestamptz(3)
  paidAt       DateTime?             @db.Timestamptz(3)
  paidById     String?               @db.Uuid
  payoutRef    String?
  voidedAt     DateTime?             @db.Timestamptz(3)
  voidReason   String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  @@index([tenantId, membershipId, status])
  @@index([tenantId, requestId])
  @@index([tenantId, earnedAt])
  @@map("commission_entries")
}

/// Chart of accounts of a centre. System accounts (systemKey) are created automatically and used by the
/// automatic postings; centres can add their own accounts for manual journals.
model LedgerAccount {
  id        String            @id @default(uuid()) @db.Uuid
  tenantId  String            @db.Uuid
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  name      String
  nameAr    String?
  type      LedgerAccountType
  systemKey String?
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @db.Timestamptz(3)
  lines     JournalLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, systemKey])
  @@map("ledger_accounts")
}

/// A balanced double-entry journal. Never changed or deleted: corrections are reversal entries.
model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNo      String
  date         DateTime      @db.Date
  memo         String
  /// INVOICE_ISSUED, INVOICE_VOIDED, PAYMENT, REFUND, CREDIT_NOTE, EXPENSE, EXPENSE_REVERSAL, COMMISSION_ACCRUED,
  /// COMMISSION_VOIDED, COMMISSION_PAID, CASH_VARIANCE, MANUAL, MANUAL_REVERSAL
  sourceType   String
  sourceId     String?
  branchId     String?       @db.Uuid
  reversalOfId String?       @db.Uuid
  createdById  String?       @db.Uuid
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  lines        JournalLine[]

  @@unique([tenantId, entryNo])
  @@index([tenantId, date])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id         String        @id @default(uuid()) @db.Uuid
  tenantId   String        @db.Uuid
  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryId    String        @db.Uuid
  entry      JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String        @db.Uuid
  account    LedgerAccount @relation(fields: [accountId], references: [id])
  debit      Decimal       @default(0) @db.Decimal(14, 2)
  credit     Decimal       @default(0) @db.Decimal(14, 2)
  memo       String?
  customerId String?       @db.Uuid
  createdAt  DateTime      @default(now()) @db.Timestamptz(3)

  @@index([tenantId, accountId])
  @@index([entryId])
  @@map("journal_lines")
}

enum GeneratedDocumentStatus {
  DRAFT
  ISSUED
  SIGNED
  HANDED_OVER
  VOID
}

/// Ready-made document templates of a centre (migration 0010): salary certificate, NOC, contracts, letters.
model DocumentTemplate {
  id                 String              @id @default(uuid()) @db.Uuid
  tenantId           String              @db.Uuid
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key                String
  /// SALARY_CERTIFICATE | NOC | CONTRACT | LETTER
  kind               String
  name               String
  nameAr             String?
  titleEn            String
  titleAr            String?
  bodyEn             String
  bodyAr             String?
  /// Fields staff fill in: [{ key, label, labelAr, type, required }]
  fields             Json                @default("[]")
  requiresSignature  Boolean             @default(true)
  isBuiltIn          Boolean             @default(false)
  isActive           Boolean             @default(true)
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  generatedDocuments GeneratedDocument[]

  @@unique([tenantId, key])
  @@map("document_templates")
}

/// A document generated from a template for a customer; final once issued, then signed and handed over.
model GeneratedDocument {
  id                String                  @id @default(uuid()) @db.Uuid
  tenantId          String                  @db.Uuid
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentNo        String
  templateId        String                  @db.Uuid
  template          DocumentTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   Int
  customerId        String                  @db.Uuid
  customer          Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestId         String?                 @db.Uuid
  branchId          String?                 @db.Uuid
  titleEn           String
  titleAr           String?
  bodyEn            String
  bodyAr            String?
  values            Json                    @default("{}")
  status            GeneratedDocumentStatus @default(DRAFT)
  requiresSignature Boolean                 @default(true)
  contentHash       String?
  issuedAt          DateTime?               @db.Timestamptz(3)
  signerName        String?
  signatureImage    String?
  signedAt          DateTime?               @db.Timestamptz(3)
  /// LINK | COUNTER
  signedVia         String?
  signedIp          String?
  handedOverAt      DateTime?               @db.Timestamptz(3)
  handedOverById    String?                 @db.Uuid
  handedOverTo      String?
  handoverNote      String?
  voidedAt          DateTime?               @db.Timestamptz(3)
  voidReason        String?
  createdById       String?                 @db.Uuid
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, documentNo])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("generated_documents")
}

/// WhatsApp team inbox (migration 0011): one conversation per phone number of a centre.
model WaConversation {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  /// E.164
  phone         String
  contactName   String?
  customerId    String?     @db.Uuid
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  branchId      String?     @db.Uuid
  /// OPEN | PENDING | CLOSED
  status        String      @default("OPEN")
  assignedToId  String?     @db.Uuid
  unreadCount   Int         @default(0)
  lastMessageAt DateTime?   @db.Timestamptz(3)
  /// Free-form replies are possible for 24 hours after the customer's last message.
  lastInboundAt DateTime?   @db.Timestamptz(3)
  lastPreview   String?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @db.Timestamptz(3)
  messages      WaMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId, status, lastMessageAt])
  @@map("wa_conversations")
}

model WaMessage {
  id                String         @id @default(uuid()) @db.Uuid
  tenantId          String         @db.Uuid
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversationId    String         @db.Uuid
  conversation      WaConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// IN | OUT | NOTE (internal, never sent)
  direction         String
  /// TEXT | TEMPLATE | IMAGE | DOCUMENT | AUDIO | OTHER
  kind              String         @default("TEXT")
  body              String?
  mediaProviderId   String?
  mediaMime         String?
  mediaName         String?
  /// The media saved to the document vault (WhatsApp intake).
  documentId        String?        @db.Uuid
  providerMessageId String?
  /// RECEIVED | QUEUED | SENT | DELIVERED | READ | FAILED | NOTE
  status            String
  error             String?
  authorId          String?        @db.Uuid
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@index([tenantId, conversationId, createdAt])
  @@map("wa_messages")
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

/// Pay set-up of one staff member (migration 0012). The IBAN is encrypted; WPS ids for the salary file.
model StaffPay {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipId       String           @db.Uuid
  membership         TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  basicSalary        Decimal          @default(0) @db.Decimal(14, 2)
  housingAllowance   Decimal          @default(0) @db.Decimal(14, 2)
  transportAllowance Decimal          @default(0) @db.Decimal(14, 2)
  otherAllowance     Decimal          @default(0) @db.Decimal(14, 2)
  /// WPS | BANK | CASH
  payMethod          String           @default("WPS")
  /// MOHRE person / labour card number used in the WPS file.
  employeeWpsId      String?
  /// Routing code (agent id) of the employee's bank.
  bankRoutingCode    String?
  ibanEnc            String?
  ibanLast4          String?
  includeCommission  Boolean          @default(true)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([tenantId, membershipId])
  @@map("staff_pay")
}

model PayrollRun {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runNo            String
  /// YYYY-MM
  period           String
  status           PayrollRunStatus @default(DRAFT)
  currency         String           @default("AED")
  totalGross       Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions  Decimal          @default(0) @db.Decimal(14, 2)
  totalNet         Decimal          @default(0) @db.Decimal(14, 2)
  notes            String?
  createdById      String?          @db.Uuid
  approvedById     String?          @db.Uuid
  approvedAt       DateTime?        @db.Timestamptz(3)
  paidById         String?          @db.Uuid
  paidAt           DateTime?        @db.Timestamptz(3)
  paymentReference String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  lines            PayrollLine[]

  @@unique([tenantId, runNo])
  @@unique([tenantId, period])
  @@map("payroll_runs")
}

model PayrollLine {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @db.Uuid
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runId              String           @db.Uuid
  run                PayrollRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  membershipId       String           @db.Uuid
  membership         TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  staffName          String
  jobTitle           String?
  payMethod          String
  daysWorked         Int
  daysInPeriod       Int
  basicSalary        Decimal          @db.Decimal(14, 2)
  allowances         Decimal          @db.Decimal(14, 2)
  overtime           Decimal          @default(0) @db.Decimal(14, 2)
  commission         Decimal          @default(0) @db.Decimal(14, 2)
  deductions         Decimal          @default(0) @db.Decimal(14, 2)
  deductionNote      String?
  gross              Decimal          @db.Decimal(14, 2)
  net                Decimal          @db.Decimal(14, 2)
  commissionEntryIds String[]         @default([]) @db.Uuid
  createdAt          DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([runId, membershipId])
  @@map("payroll_lines")
}

/// CRM leads (migration 0012): enquiries before they become customers and requests.
model Lead {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadNo         String
  name           String
  phone          String?
  email          String?
  /// WALK_IN | PHONE | WHATSAPP | WEBSITE | REFERRAL | CORPORATE | SOCIAL | OTHER
  source         String         @default("WALK_IN")
  serviceId      String?        @db.Uuid
  interest       String?
  estimatedValue Decimal?       @db.Decimal(14, 2)
  status         LeadStatus     @default(NEW)
  lostReason     String?
  ownerId        String?        @db.Uuid
  nextFollowUpAt DateTime?      @db.Timestamptz(3)
  customerId     String?        @db.Uuid
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  requestId      String?        @db.Uuid
  conversationId String?        @db.Uuid
  createdById    String?        @db.Uuid
  wonAt          DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  activities     LeadActivity[]

  @@unique([tenantId, leadNo])
  @@index([tenantId, status, nextFollowUpAt])
  @@map("leads")
}

model LeadActivity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String   @db.Uuid
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  /// NOTE | CALL | WHATSAPP | EMAIL | MEETING | STATUS
  kind        String
  body        String
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, leadId, createdAt])
  @@map("lead_activities")
}
