  offboardingAt               DateTime?                    @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  roles                       Role[]
  rolePermissions             RolePermission[]
  tenantMemberships           TenantMembership[]
  membershipBranches          MembershipBranch[]
  staffSchedules              StaffSchedule[]
  staffSkills                 StaffSkill[]
  branches                    Branch[]
  subscription                Subscription?
  subscriptionInvoices        SubscriptionInvoice[]
  subscriptionEvents          SubscriptionEvent[]
  usageRecords                UsageRecord[]
  tenantDomains               TenantDomain[]
  brandingSettings            BrandingSettings[]
  featureFlags                FeatureFlag[]
  numberSequences             NumberSequence[]
  customers                   Customer[]
  customerContacts            CustomerContact[]
  customerConsents            CustomerConsent[]
  customerNotes               CustomerNote[]
  customerTags                CustomerTag[]
  customerTagAssignments      CustomerTagAssignment[]
  corporateAccounts           CorporateAccount[]
  corporateMembers            CorporateMember[]
  corporateEmployees          CorporateEmployee[]
  corporateAgreements         CorporateAgreement[]
  corporatePrices             CorporatePrice[]
  serviceCategories           ServiceCategory[]
  documentTypes               DocumentType[]
  services                    Service[]
  serviceBranches             ServiceBranch[]
  servicePrices               ServicePrice[]
  serviceRequirements         ServiceRequirement[]
  serviceFormDefinitions      ServiceFormDefinition[]
  workflowDefinitions         WorkflowDefinition[]
  workflowVersions            WorkflowVersion[]
  workflowSteps               WorkflowStep[]
  serviceRequests             ServiceRequest[]
  requestFields               RequestField[]
  requestDocuments            RequestDocument[]
  requestStatusHistories      RequestStatusHistory[]
  requestAssignments          RequestAssignment[]
  requestApprovals            RequestApproval[]
  requestComments             RequestComment[]
  requestExternalReferences   RequestExternalReference[]
  workflowExecutions          WorkflowExecution[]
  workflowStepExecutions      WorkflowStepExecution[]
  documents                   Document[]
  documentVersions            DocumentVersion[]
  documentAccessLogs          DocumentAccessLog[]
  documentShares              DocumentShare[]
  documentVerificationResults DocumentVerificationResult[]
  ocrExtractionResults        OcrExtractionResult[]
  aiUsageLogs                 AiUsageLog[]
  feeComponents               FeeComponent[]
  quotations                  Quotation[]
  quotationItems              QuotationItem[]
  invoices                    Invoice[]
  invoiceItems                InvoiceItem[]
  payments                    Payment[]
  paymentAllocations          PaymentAllocation[]
  refunds                     Refund[]
  creditNotes                 CreditNote[]
  expenses                    Expense[]
  liabilityEntries            LiabilityEntry[]
  reconciliationRecords       ReconciliationRecord[]
  idempotencyKeys             IdempotencyKey[]
  appointmentSlotConfigs      AppointmentSlotConfig[]
  branchClosures              BranchClosure[]
  appointments                Appointment[]
  queueTokens                 QueueToken[]
  tasks                       Task[]
  taskAssignments             TaskAssignment[]
  notificationTemplates       NotificationTemplate[]
  notifications               Notification[]
  notificationDeliveries      NotificationDelivery[]
  notificationPreferences     NotificationPreference[]
  deviceTokens                DeviceToken[]
  reminderSchedules           ReminderSchedule[]
  reminderDispatches          ReminderDispatch[]
  slaPolicies                 SlaPolicy[]
  supportTickets              SupportTicket[]
  supportMessages             SupportMessage[]
  customerFeedbacks           CustomerFeedback[]
  automationRules             AutomationRule[]
