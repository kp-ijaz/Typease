  @@index([tenantId, requestId])
  @@index([tenantId, customerId])
  @@index([tenantId, corporateAccountId, status])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, issuedAt])
  @@map("invoices")
}

model InvoiceItem {
