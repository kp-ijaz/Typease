}

model Invoice {
  id                    String              @id @default(uuid()) @db.Uuid
  tenantId              String              @db.Uuid
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId              String              @db.Uuid
  branch                Branch              @relation(fields: [branchId], references: [id])
  invoiceNo             String
  requestId             String?             @db.Uuid
  request               ServiceRequest?     @relation(fields: [requestId], references: [id])
  quotationId           String?             @db.Uuid
  quotation             Quotation?          @relation(fields: [quotationId], references: [id])
  customerId            String              @db.Uuid
  customer              Customer            @relation(fields: [customerId], references: [id])
  corporateAccountId    String?             @db.Uuid
  corporateAccount      CorporateAccount?   @relation(fields: [corporateAccountId], references: [id])
  status                InvoiceStatus       @default(DRAFT)
  currency              String              @default("AED")
  subtotalServiceFee    Decimal             @default(0) @db.Decimal(14, 2)
  subtotalGovernmentFee Decimal             @default(0) @db.Decimal(14, 2)
  subtotalThirdParty    Decimal             @default(0) @db.Decimal(14, 2)
  discountTotal         Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal              Decimal             @default(0) @db.Decimal(14, 2)
  total                 Decimal             @default(0) @db.Decimal(14, 2)
  amountPaid            Decimal             @default(0) @db.Decimal(14, 2)
  amountCredited        Decimal             @default(0) @db.Decimal(14, 2)
  amountRefunded        Decimal             @default(0) @db.Decimal(14, 2)
  balanceDue            Decimal             @default(0) @db.Decimal(14, 2)
  issuedAt              DateTime?           @db.Timestamptz(3)
  dueAt                 DateTime?           @db.Timestamptz(3)
  voidedAt              DateTime?           @db.Timestamptz(3)
  voidReason            String?
  notes                 String?
  createdById           String?             @db.Uuid
