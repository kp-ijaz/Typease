  timezone                    String                       @default("Asia/Dubai")
  defaultCurrency             String                       @default("AED")
  defaultLanguage             String                       @default("en")
  contactEmail                String?
  contactPhone                String?
  tradeLicenceNo              String?
  taxRegistrationNo           String?
  taxRatePercent              Decimal                      @default(5) @db.Decimal(5, 2)
  aiEnabled                   Boolean                      @default(false)
  onboardingStep              Int                          @default(0)
  onboardingData              Json                         @default("{}")
  settings                    Json                         @default("{}")
  approvedAt                  DateTime?                    @db.Timestamptz(3)
  cashierShifts               CashierShift[]
  invoiceReminders            InvoiceReminder[]
  commissionRules             CommissionRule[]
  commissionEntries           CommissionEntry[]
  ledgerAccounts              LedgerAccount[]
  journalEntries              JournalEntry[]
  journalLines                JournalLine[]
  approvedById                String?                      @db.Uuid
  suspendedAt                 DateTime?                    @db.Timestamptz(3)
