}

/// Money held on behalf of others (government / third-party fees).
/// ACCRUAL when collected from the customer, REMITTANCE when paid out,
/// REVERSAL when refunded. Balance = liability still owed.
model LiabilityEntry {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String           @db.Uuid
  component  FeeComponentType
  /// ACCRUAL | REMITTANCE | REVERSAL
  direction  String
  amount     Decimal          @db.Decimal(14, 2)
  currency   String           @default("AED")
  requestId  String?          @db.Uuid
  invoiceId  String?          @db.Uuid
  sourceType String
  sourceId   String           @db.Uuid
  occurredAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([tenantId, component, occurredAt])
  @@index([tenantId, requestId])
  @@map("liability_entries")
}

model ReconciliationRecord {
  id                 String        @id @default(uuid()) @db.Uuid
