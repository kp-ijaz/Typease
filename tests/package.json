{
  "name": "@typease/tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "pnpm --filter @typease/api exec jest --runInBand --config ../../tests/jest.config.js",
    "test:integration": "pnpm --filter @typease/api exec jest --runInBand --config ../../tests/jest.integration.config.js",
    "test:security": "pnpm --filter @typease/api exec jest --runInBand --config ../../tests/jest.security.config.js",
    "test:e2e": "node e2e/not-written.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.18.8",
    "typescript": "5.9.3"
  }
}
