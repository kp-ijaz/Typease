# /etc/typease/compose.env - NOT secret. Variables interpolated by docker-compose.prod.yml:
#   docker compose --env-file /etc/typease/compose.env -f docker-compose.prod.yml ...

# Images pushed by .github/workflows/release.yml:  <prefix>-api:<version>, <prefix>-worker:<version>,
# <prefix>-centre-web:<version> ...   Deploy an immutable version (v1.4.2 or sha-<commit>), never "latest".
TYPEASE_IMAGE_PREFIX=ghcr.io/your-org/typease
TYPEASE_VERSION=v1.0.0
# Web images are built per environment (NEXT_PUBLIC_API_URL is compiled in). release.yml names
# non-production web images <prefix>-<app>-<environment>: set e.g. -staging here. Empty for production.
TYPEASE_WEB_IMAGE_SUFFIX=

# Base domain (same value as PLATFORM_BASE_DOMAIN in typease.env and TYPEASE_BASE_DOMAIN in caddy.env).
TYPEASE_BASE_DOMAIN=example.ae

# Directory with the secret env files (chmod 700, files chmod 600, owner root).
TYPEASE_ENV_DIR=/etc/typease

# Optional services on this host. Remove an entry when you use a managed service instead.
COMPOSE_PROFILES=bundled-postgres,bundled-redis,bundled-minio,clamav,monitoring

API_REPLICAS=2
WORKER_REPLICAS=1
WEB_REPLICAS=1
# Jobs processed in parallel by EACH worker replica (default 5). See docs/deployment/scaling.md.
WORKER_CONCURRENCY=5

# Origin(s) of the object store that browsers reach through presigned URLs (space separated).
# Added to the web apps' Content-Security-Policy. Bundled MinIO: https://s3.<base domain>.
# AWS S3: the bucket endpoint, e.g. https://typease-prod-documents.s3.me-central-1.amazonaws.com
STORAGE_PUBLIC_ORIGINS=https://s3.example.ae

# Bundled PostgreSQL / Redis sizing (ignored with managed services).
POSTGRES_MAX_CONNECTIONS=150
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
REDIS_MAXMEMORY=512mb

# Only for the wildcard-certificate option (custom Caddy build with a DNS module).
# CADDY_IMAGE=ghcr.io/your-org/typease-caddy:2.10.0

# Monitoring
PROMETHEUS_RETENTION=30d
PROMETHEUS_TARGETS_DIR=/etc/typease/prometheus-targets
NODE_EXPORTER_TEXTFILE_DIR=/var/backups/typease/metrics
