# /etc/typease/caddy.env - reverse proxy.   chmod 600
TYPEASE_BASE_DOMAIN=example.ae
# Contact address of the ACME account (certificate expiry notices).
ACME_EMAIL=ops@example.ae
# Request body limit of the API host. Keep it above UPLOAD_MAX_BYTES (15 MiB).
UPLOAD_MAX_BODY=16MB
# STORAGE_DRIVER=s3: serve /api/v1/public/assets/<key> from the public assets bucket.
S3_PUBLIC_ASSETS_PROXY=true
# Bundled MinIO: http://minio:9000 . AWS path-style: https://s3.<region>.amazonaws.com
S3_PUBLIC_ASSETS_UPSTREAM=http://minio:9000
S3_PUBLIC_ASSETS_BUCKET=typease-prod-public-assets
# Only for the wildcard-certificate option (sites/wildcard.caddy): DNS provider API token.
# CADDY_DNS_API_TOKEN=
# Only for sites/grafana.caddy / sites/n8n.caddy: output of `caddy hash-password`.
# OPS_BASIC_AUTH_USER=ops
# OPS_BASIC_AUTH_HASH=
