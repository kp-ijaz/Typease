# /etc/typease/backup.env - read by scripts/db-backup.sh, db-restore.sh and storage-backup.sh.   chmod 600
# Run from cron / a systemd timer, e.g.:
#   15 1 * * *  root  /opt/typease/scripts/db-backup.sh --env-file /etc/typease/backup.env >> /var/log/typease-backup.log 2>&1

# --- what to dump -------------------------------------------------------------------------
# A role that can read EVERY row: the schema owner (DATABASE_MIGRATION_URL) or, better, the
# read-only typease_backup role (BYPASSRLS + pg_read_all_data). typease_app cannot be used:
# row-level security hides all tenant rows from it and pg_dump aborts.
# From the host, the bundled database is reachable through `docker compose exec`; set
# BACKUP_PG_DUMP_CMD accordingly (see scripts/db-backup.sh --help) or use a reachable host name.
BACKUP_DATABASE_URL=postgresql://typease_backup:<backup-password>@127.0.0.1:5432/typease

# --- where to keep it ---------------------------------------------------------------------
BACKUP_DIR=/var/backups/typease
# Local retention. The off-site copy should have its own lifecycle rule (e.g. 35 days + monthly).
BACKUP_RETENTION_DAYS=14
# Marker read by scripts/production-readiness.mjs (--backup-marker) and the metric file read by
# node-exporter (alert TypeaseBackupTooOld). Defaults: $BACKUP_DIR/last-success.json and $BACKUP_DIR/metrics
# BACKUP_MARKER_FILE=/var/backups/typease/last-success.json
# BACKUP_METRICS_DIR=/var/backups/typease/metrics

# --- encryption (mandatory: the scripts refuse to write an unencrypted dump) ---------------
# Preferred: age with PUBLIC recipient keys. The server can only ENCRYPT; the private key
# stays offline with the people who are allowed to restore. Several recipients, comma separated.
# Create a key pair OFF the server:  age-keygen -o typease-backup.agekey   (prints the public key)
BACKUP_AGE_RECIPIENTS=<age1... public key>
# Alternative when age is not installed: symmetric AES-256 (openssl enc -aes-256-cbc -pbkdf2).
# The passphrase is then present on the server: weaker custody. Do not set both.
# BACKUP_PASSPHRASE=<openssl rand -base64 48>

# --- off-site copy (strongly recommended) --------------------------------------------------
# s3://bucket/prefix on any S3-compatible store, uploaded with the aws CLI (or `mc` when
# BACKUP_UPLOAD_TOOL=mc and BACKUP_S3_URI is an mc alias path such as offsite/typease-backups/db).
# BACKUP_S3_URI=s3://typease-prod-backups/db
# BACKUP_S3_ENDPOINT=https://s3.example.ae
# BACKUP_UPLOAD_TOOL=aws
# AWS_ACCESS_KEY_ID=<write-only backup key>
# AWS_SECRET_ACCESS_KEY=<secret>
# AWS_DEFAULT_REGION=me-central-1

# --- restore (only on the machine that performs a restore / drill) -------------------------
# BACKUP_AGE_IDENTITY_FILE=/root/keys/typease-backup.agekey
# Administrative connection allowed to CREATE DATABASE (never the production database URL of the app).
# RESTORE_ADMIN_URL=postgresql://postgres:<password>@127.0.0.1:5432/postgres

# --- object storage mirror (scripts/storage-backup.sh) -------------------------------------
# STORAGE_BACKUP_SOURCE=s3://typease-prod-documents
# STORAGE_BACKUP_TARGET=s3://typease-prod-documents-replica
# STORAGE_BACKUP_SOURCE_ENDPOINT=https://s3.example.ae
# STORAGE_BACKUP_TARGET_ENDPOINT=https://s3.other-region.example.com
