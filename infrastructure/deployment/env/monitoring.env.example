# /etc/typease/monitoring.env - monitoring stack (profile monitoring).   chmod 600
# Must equal INTERNAL_API_TOKEN in typease.env (Prometheus sends it as x-internal-token).
INTERNAL_API_TOKEN=<same value as in typease.env>
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<openssl rand -hex 16>
# Public URL of Grafana when it is published through Caddy (sites/grafana.caddy).
# GF_SERVER_ROOT_URL=https://grafana.example.ae
# postgres-exporter: the typease_monitor role (pg_monitor; no access to table data).
DATA_SOURCE_NAME=postgresql://typease_monitor:<monitor-password>@postgres:5432/typease?sslmode=disable
# redis-exporter
REDIS_ADDR=redis://redis:6379
REDIS_PASSWORD=<redis-password>
