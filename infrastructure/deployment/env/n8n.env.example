# /etc/typease/n8n.env - n8n (profile n8n).   chmod 600
# Encrypts the credentials stored in n8n. Escrow it: without it the n8n volume is useless.
N8N_ENCRYPTION_KEY=<openssl rand -base64 32>
N8N_HOST=n8n.example.ae
N8N_PORT=5678
N8N_PROTOCOL=https
# URL under which n8n believes its webhooks are reachable. The API calls it inside the network.
WEBHOOK_URL=http://n8n:5678/
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
GENERIC_TIMEZONE=Asia/Dubai
TZ=Asia/Dubai
