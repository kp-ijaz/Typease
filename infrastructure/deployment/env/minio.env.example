# /etc/typease/minio.env - bundled MinIO (profile bundled-minio).   chmod 600
MINIO_ROOT_USER=<root-user-name>
MINIO_ROOT_PASSWORD=<openssl rand -hex 24>
# Built-in KMS key for server-side encryption (the API uploads with SSE-S3).
# Format <name>:<base64 of 32 bytes>, e.g.  typease-kms:$(openssl rand -base64 32)
# ESCROW THIS KEY: without it no stored object can be read, backups included.
MINIO_KMS_SECRET_KEY=typease-kms:<openssl rand -base64 32>
# Public URL of the S3 API (= S3_ENDPOINT in typease.env).
MINIO_SERVER_URL=https://s3.example.ae
