# /etc/typease/typease.env - PRODUCTION environment of the API and the worker.   chmod 600
# Reference with the explanation of every variable: .env.example in the repository root.
# Generate the secrets with scripts/generate-secrets.sh. Check the finished file with:
#   node scripts/production-readiness.mjs --env-file /etc/typease/typease.env --env-file /etc/typease/migrate.env
#
# Every value written as <...> MUST be replaced. The API refuses to start with unsafe values.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# json (one object per line, for the log collector) | text
LOG_FORMAT=json

# --- public URLs (HTTPS, bare origins) -----------------------------------------------
API_PUBLIC_URL=https://api.example.ae
CENTRE_WEB_URL=https://app.example.ae
CUSTOMER_WEB_URL=https://portal.example.ae
CORPORATE_WEB_URL=https://corporate.example.ae
PLATFORM_ADMIN_URL=https://admin.example.ae
PLATFORM_BASE_DOMAIN=example.ae
CUSTOM_DOMAIN_CNAME_TARGET=portal.example.ae
CORS_ORIGINS=

# --- data stores ------------------------------------------------------------------------
# Bundled services: hosts "postgres" and "redis". Managed services: the provider's host
# names, ?sslmode=require on the database URLs and rediss:// for Redis.
# The role names are fixed; use hex passwords (no URL-encoding problems).
DATABASE_URL=postgresql://typease_app:<app-password>@postgres:5432/typease
DATABASE_SYSTEM_URL=postgresql://typease_system:<system-password>@postgres:5432/typease
DATABASE_POOL_MAX=10
REDIS_URL=redis://:<redis-password>@redis:6379/0

# --- secrets ----------------------------------------------------------------------------
# Every secret must be a GENERATED value and different from the others: the API refuses to start
# with a published development value, a placeholder, a typed phrase or a value used twice.
JWT_ACCESS_SECRET=<openssl rand -base64 48>
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
DATA_ENCRYPTION_KEY=<openssl rand -base64 32>
# Name of that key; it is stamped on everything that is encrypted. Change it only when rotating:
# new key + new id here, the previous pair moves to DATA_ENCRYPTION_OLD_KEYS (docs/deployment/secrets.md).
DATA_ENCRYPTION_KEY_ID=k1
# Previous keys, for decryption only: id:base64,id:base64 (empty until the first rotation).
DATA_ENCRYPTION_OLD_KEYS=
HMAC_KEY=<openssl rand -base64 48>
# At least 24 characters.
INTERNAL_API_TOKEN=<openssl rand -base64 32>
COOKIE_SECURE=true
# COOKIE_DOMAIN=

# --- auth policy ------------------------------------------------------------------------
MFA_ENFORCEMENT=required
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 10 to 128.
PASSWORD_MIN_LENGTH=10
OTP_TTL_SECONDS=300
EXPOSE_DEV_TOKENS=false
SELF_SIGNUP_ENABLED=true
TENANT_APPROVAL_REQUIRED=true
ONBOARDING_REQUIRE_PHONE_VERIFICATION=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# --- background jobs: executed by the worker service ----------------------------------
QUEUE_DRIVER=bullmq
QUEUE_INLINE_AUTORUN=false

# --- object storage -------------------------------------------------------------------
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=/data/storage
# AWS S3: leave S3_ENDPOINT unset and set S3_FORCE_PATH_STYLE=false.
# Bundled MinIO: the PUBLIC https URL served by Caddy (sites/minio.caddy), e.g. https://s3.example.ae
S3_ENDPOINT=https://s3.example.ae
S3_REGION=me-central-1
S3_BUCKET=typease-prod-documents
S3_PUBLIC_ASSETS_BUCKET=typease-prod-public-assets
# Optional CDN / public URL of the public assets bucket.
# S3_PUBLIC_ASSETS_BASE_URL=https://assets.example.ae
S3_ACCESS_KEY_ID=<access-key-id>
S3_SECRET_ACCESS_KEY=<secret-access-key>
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp
DOWNLOAD_URL_TTL_SECONDS=120
UPLOAD_URL_TTL_SECONDS=600

# --- malware scanning (profile "clamav") ------------------------------------------------
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
REQUIRE_CLEAN_SCAN=true

# --- notifications ----------------------------------------------------------------------
MAIL_DRIVER=smtp
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS=no-reply@example.ae
MAIL_FROM_NAME=TypEase
# twilio | http | log
SMS_DRIVER=log
# SMS_HTTP_URL=
# SMS_HTTP_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# meta | log
WHATSAPP_DRIVER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# fcm | log
PUSH_DRIVER=log
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=

# --- OCR ----------------------------------------------------------------------------------
OCR_PROVIDER=disabled
# OCR_EXTERNAL_URL=
# OCR_EXTERNAL_TOKEN=
OCR_COST_PER_PAGE=0

# --- payments ---------------------------------------------------------------------------
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_SANDBOX_WEBHOOK_SECRET=<openssl rand -base64 32>
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- automation -------------------------------------------------------------------------
# N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
# N8N_WEBHOOK_SECRET=
OUTBOUND_WEBHOOK_ALLOWED_HOSTS=

# --- worker -----------------------------------------------------------------------------
# docker-compose.prod.yml sets WORKER_CONCURRENCY and WORKER_SHUTDOWN_TIMEOUT_MS on the worker
# service (they override the two values below); keep them here for installations without compose.
WORKER_CONCURRENCY=5
WORKER_SHUTDOWN_TIMEOUT_MS=30000
WORKER_HEALTH_PORT=4100
WORKER_OUTBOX_INTERVAL_MS=10000
# Seconds between two heartbeats of the worker (5 to 300). The platform console shows the worker
# as STALE after two intervals without one. Same value for the API and the worker.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
