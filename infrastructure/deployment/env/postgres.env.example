# /etc/typease/postgres.env - bundled PostgreSQL (profile bundled-postgres).   chmod 600
# These values are applied ONCE, when the data volume is initialised.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<openssl rand -hex 24>
TYPEASE_DB_NAME=typease
TYPEASE_DB_OWNER=typease_owner
# Same password as in DATABASE_MIGRATION_URL (migrate.env).
TYPEASE_DB_OWNER_PASSWORD=<owner-password>
# Read-only role for pg_dump (BACKUP_DATABASE_URL in backup.env). Empty = not created.
TYPEASE_DB_BACKUP_PASSWORD=<openssl rand -hex 24>
# Role for postgres-exporter (DATA_SOURCE_NAME in monitoring.env). Empty = not created.
TYPEASE_DB_MONITOR_PASSWORD=<openssl rand -hex 24>
