# DEVELOPMENT DEFAULTS - NOT FOR PRODUCTION.
# Bootstrap superuser of the postgres container (used by nothing but the init script and psql).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_pw
# Read by infrastructure/docker/postgres/init/01-typease-roles.sh on the first start.
TYPEASE_DB_NAME=typease
TYPEASE_DB_OWNER=typease_owner
TYPEASE_DB_OWNER_PASSWORD=owner_dev_pw
# Optional roles: leave empty to skip. Changing them later has no effect on an existing volume.
TYPEASE_DB_BACKUP_PASSWORD=backup_dev_pw
TYPEASE_DB_MONITOR_PASSWORD=monitor_dev_pw
