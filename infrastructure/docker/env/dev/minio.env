# DEVELOPMENT DEFAULTS - NOT FOR PRODUCTION.
MINIO_ROOT_USER=typease-dev-root
MINIO_ROOT_PASSWORD=typease-dev-root-password
# Built-in single-key KMS. Required because the API uploads with
# x-amz-server-side-encryption: AES256 (SSE-S3); MinIO refuses that header without a KMS.
# Format: <key name>:<base64 of 32 bytes>. Losing this key makes every stored object unreadable.
MINIO_KMS_SECRET_KEY=typease-dev-key:dHlwZWFzZS1taW5pby1kZXYta21zLWtleS0zMmJ5dGU=
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
