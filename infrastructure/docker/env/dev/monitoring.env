# DEVELOPMENT DEFAULTS - NOT FOR PRODUCTION. Only used with `--profile monitoring`.
# Must equal INTERNAL_API_TOKEN in api.env: Prometheus sends it as the x-internal-token header.
INTERNAL_API_TOKEN=dev-internal-token-change-me
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=grafana_dev_pw
# postgres-exporter (role created by the postgres init script) and redis-exporter.
DATA_SOURCE_NAME=postgresql://typease_monitor:monitor_dev_pw@postgres:5432/typease?sslmode=disable
REDIS_ADDR=redis://redis:6379
