# =============================================================================
# DEVELOPMENT DEFAULTS for docker-compose.yml - NOT FOR PRODUCTION.
# Every secret below is a fixed, publicly known development value.
# Reference for all variables: .env.example (repository root).
# =============================================================================
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- public URLs (through the Caddy container; *.localhost resolves to 127.0.0.1 in browsers)
# If you change HTTP_PORT from 80, append :<port> to these six values.
API_PUBLIC_URL=http://api.typease.localhost
CENTRE_WEB_URL=http://app.typease.localhost
CUSTOMER_WEB_URL=http://portal.typease.localhost
CORPORATE_WEB_URL=http://corporate.typease.localhost
PLATFORM_ADMIN_URL=http://admin.typease.localhost
PLATFORM_BASE_DOMAIN=typease.localhost
CUSTOM_DOMAIN_CNAME_TARGET=portal.typease.localhost
# The apps started with pnpm on the host (ports 3001-3004) may call this API too.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# --- data stores (service names of the Compose network)
DATABASE_URL=postgresql://typease_app:app_dev_pw@postgres:5432/typease
DATABASE_SYSTEM_URL=postgresql://typease_system:system_dev_pw@postgres:5432/typease
DATABASE_POOL_MAX=10
REDIS_URL=redis://redis:6379/0

# --- secrets (development values)
JWT_ACCESS_SECRET=docker-development-jwt-secret-0123456789abcdef
DATA_ENCRYPTION_KEY=dHlwZWFzZS1kb2NrZXItZGV2LWtleS0zMi1ieXRlcyE=
HMAC_KEY=docker-development-hmac-key-0123456789abcdef
INTERNAL_API_TOKEN=dev-internal-token-change-me
COOKIE_SECURE=false

# --- auth policy (relaxed for demos)
MFA_ENFORCEMENT=optional
EXPOSE_DEV_TOKENS=true
ONBOARDING_REQUIRE_PHONE_VERIFICATION=false
RATE_LIMIT_ENABLED=true

# --- queue: jobs are executed by the worker container.
# Single-process fallback (no worker): QUEUE_DRIVER=inline and QUEUE_INLINE_AUTORUN=true
QUEUE_DRIVER=bullmq
QUEUE_INLINE_AUTORUN=false

# --- object storage: MinIO. The endpoint must be the SAME URL for the browser and for the
# containers (it is part of every presigned URL): Caddy serves it and carries a network alias.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://s3.typease.localhost
S3_REGION=me-central-1
S3_BUCKET=typease-documents
S3_PUBLIC_ASSETS_BUCKET=typease-public-assets
S3_ACCESS_KEY_ID=typease-dev-app
S3_SECRET_ACCESS_KEY=typease-dev-app-secret-key
S3_FORCE_PATH_STYLE=true
# Only used by the single-host fallback STORAGE_DRIVER=local (volume storage-data).
STORAGE_LOCAL_DIR=/data/storage

# --- malware scanning: ClamAV container (first start downloads the signature database)
MALWARE_SCANNER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
REQUIRE_CLEAN_SCAN=false

# --- email: Mailpit catches everything (web UI on http://localhost:8025)
MAIL_DRIVER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM_ADDRESS=no-reply@typease.localhost
MAIL_FROM_NAME=TypEase (development)
SMS_DRIVER=log
WHATSAPP_DRIVER=log
PUSH_DRIVER=log

# --- OCR (bundled English model, no external service)
OCR_PROVIDER=tesseract

# --- payments: sandbox adapter (no money moves; refused when NODE_ENV=production)
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-change-me

# --- automation
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_WEBHOOK_SECRET=dev-n8n-webhook-secret-change-me
OUTBOUND_WEBHOOK_ALLOWED_HOSTS=n8n
