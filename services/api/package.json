{
  "name": "@typease/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --watch --watch-path=src -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=366",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern=\\.unit\\.",
    "openapi": "node -r @swc-node/register src/cli/openapi.ts",
    "seed": "node -r @swc-node/register src/cli/seed.ts",
    "platform-admin": "node -r @swc-node/register src/cli/platform-admin.ts",
    "reencrypt": "node -r @swc-node/register src/cli/reencrypt.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.864.0",
    "@aws-sdk/s3-request-presigner": "3.864.0",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@node-rs/argon2": "2.0.2",
    "@tesseract.js-data/eng": "1.0.0",
    "@typease/database": "workspace:*",
    "@typease/permissions": "workspace:*",
    "@typease/types": "workspace:*",
    "@typease/validation": "workspace:*",
    "bullmq": "5.58.5",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "ioredis": "5.7.0",
    "jsonwebtoken": "9.0.2",
    "nestjs-zod": "4.3.1",
    "nodemailer": "6.10.1",
    "otplib": "12.0.1",
    "pdfkit": "0.17.2",
    "pino": "9.9.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tesseract.js": "5.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/testing": "11.1.6",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.13.5",
    "@swc/jest": "0.2.39",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.8",
    "@types/nodemailer": "6.4.19",
    "@types/pdfkit": "0.17.2",
    "@types/smtp-server": "3.5.10",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "smtp-server": "3.14.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3"
  }
}
