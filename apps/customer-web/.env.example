# TypEase customer portal (apps/customer-web). Copy to .env.local for local development.

# Public URL of the TypEase API as the BROWSER reaches it. Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: the same URL read at RUN time by the server (layout, middleware).
# API_PUBLIC_URL=https://api.example.ae

# Optional: how THIS server reaches the API (tenant lookup, and the /api/v1 proxy used on tenant
# domains; the proxy target is fixed at build time). Defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:4000

# Which centre to show when the host is not a tenant domain and no ?tenant=<slug> was given
# (single-centre deployments, local development). Leave empty on the shared portal.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=

# Hosts of the shared portal itself (never looked up as a tenant domain). Space- or comma-separated.
# localhost and 127.0.0.1 are always treated as shared.
# PORTAL_SHARED_HOSTS=portal.typease.ae

# Optional: origins of the file store when uploads / downloads use signed URLs on another host.
# NEXT_PUBLIC_STORAGE_ORIGINS=https://files.example.ae

# Demo sites only - never in production. The shared seed password (docs/DEMO_ENVIRONMENT.md); enables
# one-click demo logins from the landing page: /sign-in?demo=<seeded .test email>.
# NEXT_PUBLIC_DEMO_PASSWORD=TypEase-Demo-2026
