# TypEase staff app (apps/centre-web). Copy to .env.local for local development.

# Public URL of the TypEase API as the BROWSER reaches it. Inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: the same URL read at RUN time by the server (layout, middleware). Lets one Docker image
# serve several environments; when unset the value above is used.
# API_PUBLIC_URL=https://api.example.ae

# Optional: origins of the file store when uploads / downloads use signed URLs on another host
# (S3, MinIO). Space- or comma-separated. Added to the Content-Security-Policy.
# NEXT_PUBLIC_STORAGE_ORIGINS=https://files.example.ae

# Optional: show the component gallery at /dev/components in a production build.
# ENABLE_DEV_GALLERY=true

# Demo sites only - never in production. The shared seed password (docs/DEMO_ENVIRONMENT.md); enables
# one-click demo logins from the landing page: /sign-in?demo=<seeded .test email>.
# NEXT_PUBLIC_DEMO_PASSWORD=TypEase-Demo-2026
