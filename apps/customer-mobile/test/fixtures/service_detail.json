        {
          "key": "visa",
          "title": "Visa details",
          "fields": [
            {
              "key": "visaType",
              "type": "select",
              "label": "Type of visa",
              "labelAr": "نوع التأشيرة",
              "options": [
                {
                  "label": "Visit",
                  "value": "visit",
                  "labelAr": "زيارة"
                },
                {
                  "label": "Tourist",
                  "value": "tourist",
                  "labelAr": "سياحية"
                },
                {
                  "label": "Residence",
                  "value": "residence",
                  "labelAr": "إقامة"
