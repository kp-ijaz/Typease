                  "value": "other",
                  "labelAr": "أخرى"
                }
              ],
              "required": true
            },
            {
              "key": "sponsorType",
              "type": "radio",
              "label": "Who is the sponsor?",
              "labelAr": "من هو الكفيل؟",
              "options": [
                {
                  "label": "Family member",
                  "value": "family",
                  "labelAr": "أحد أفراد الأسرة"
                },
                {
                  "label": "Company",
                  "value": "company",
                  "labelAr": "شركة"
