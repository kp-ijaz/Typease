# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
pubspec.lock.bak
*.iml
.idea/
.vscode/

# Native folders are generated by tool/bootstrap.sh (flutter create). Commit them once they
# have been generated and reviewed on a developer machine; until then they do not exist here.
# android/
# ios/

# Firebase configuration is per deployment and must not be committed to a shared repository.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json

# Signing
android/key.properties
*.jks
*.keystore
*.p12
*.mobileprovision

# Build configuration (--dart-define-from-file). Only the *.example.json files are kept.
config/*.json
!config/*.example.json
