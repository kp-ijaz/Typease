  },
  "dependencies": { "@typease/types": "workspace:*" },
  "peerDependencies": { "react": ">=19" },
  "devDependencies": {
    "@types/node": "22.18.8",
    "@types/react": "19.1.15",
    "@types/react-dom": "19.1.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
