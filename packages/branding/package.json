{
  "name": "@typease/branding",
  "version": "1.0.0",
  "private": true,
  "description": "TypEase brand: design tokens, logo, and white-label theme maths.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
