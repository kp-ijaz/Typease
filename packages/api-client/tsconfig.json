{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@typease/types": ["../types/src/index.ts"],
      "@typease/validation": ["../validation/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
