{
  "name": "@typease/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "Typed, framework-agnostic client for the TypEase REST API.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": { "@typease/types": "workspace:*", "@typease/validation": "workspace:*" },
  "devDependencies": { "typescript": "5.9.3", "vitest": "3.2.4", "@types/node": "22.18.8" }
}
