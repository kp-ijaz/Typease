# =============================================================================
# TypEase - environment reference (API + worker)
#
# This file documents EVERY variable validated by services/api/src/config/env.ts, with the
# values for LOCAL DEVELOPMENT on the host (pnpm) against the dependency containers:
#
#     cp .env.example .env            # .env is git-ignored
#     docker compose --profile deps up -d
#     scripts/dev-up.sh --host        # or: set -a; . ./.env; set +a; pnpm db:migrate; pnpm dev:api
#
# Optional variables without a default are shown commented out ("# NAME="): leave them unset
# rather than empty.
#
# The API does not read .env files by itself: the variables must be in the process
# environment (the scripts above export them; containers use env_file).
#
# Other templates:
#   infrastructure/docker/env/dev/*.env            development values of docker-compose.yml
#   infrastructure/deployment/env/*.env.example    PRODUCTION templates (start from those, not from this file)
#   apps/<app>/.env.example                        frontend variables (NEXT_PUBLIC_*; owned by the web apps)
#   apps/customer-mobile/README.md                 Flutter --dart-define values
#
# Legend:  [PROD-REQUIRED]  must be set explicitly in production (the API refuses to start,
#                           or scripts/production-readiness.mjs fails, when it is not)
#          [SECRET]         never commit a real value; generate with scripts/generate-secrets.sh
#
# The values below are DEVELOPMENT values. `pnpm check:production` fails on every one of them.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production. "production" switches on the start-up safety checks
# (secure cookies, MFA required, no sandbox payments, no dev tokens, no placeholder secrets)
# and switches off Swagger UI (/api/docs).                                   [PROD-REQUIRED]
NODE_ENV=development
# HTTP port of the API.
PORT=4000
# fatal | error | warn | info | debug | trace | silent. debug / trace may log personal data.
LOG_LEVEL=info
# json = one structured object per line (the default when NODE_ENV=production; what a log collector
# wants).  text = readable console output (the default everywhere else).
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Public URLs  (bare origins: scheme + host [+ port], no path, no trailing slash)
# Used for CORS, links in emails / notifications and redirects after payment.
# Production: all HTTPS.                                                     [PROD-REQUIRED]
# -----------------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:4000
CENTRE_WEB_URL=http://localhost:3001
CUSTOMER_WEB_URL=http://localhost:3002
CORPORATE_WEB_URL=http://localhost:3003
PLATFORM_ADMIN_URL=http://localhost:3004
# Every centre automatically gets <slug>.<PLATFORM_BASE_DOMAIN>.              [PROD-REQUIRED]
PLATFORM_BASE_DOMAIN=typease.localhost
# Host name that centres point a CNAME at for a custom domain. It must resolve to the
# reverse proxy and be served by it (portal.<base> in Caddyfile.prod).        [PROD-REQUIRED]
CUSTOM_DOMAIN_CNAME_TARGET=portal.typease.localhost
# Extra browser origins allowed by CORS, comma separated. The four app URLs above, tenant
# sub-domains and verified custom domains are always allowed. Usually empty.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# PostgreSQL - THREE connections, three roles (see docs/security/BACKUP_AND_RECOVERY.md
# and database/scripts/migrate.ts)
#
#   DATABASE_URL            role typease_app     every tenant request. Subject to row-level
#                                                security: it can only see rows of the tenant
#                                                bound to the current transaction. It must
#                                                NEVER be a superuser, BYPASSRLS or table owner.
#   DATABASE_SYSTEM_URL     role typease_system  cross-tenant code only (sign-in, tenant
#                                                resolution, billing, schedulers, webhooks).
#   DATABASE_MIGRATION_URL  role typease_owner   owns the schema. Used ONLY by the migration
#                                                job, backups and the readiness check. Do not
#                                                give it to the API or worker in production.
#
# The role NAMES typease_app / typease_system are fixed (the migration runner refuses other
# names). Their passwords are taken from these URLs: the migration runner sets them on every
# run, so rotating a password = change the URL, run the migration job, restart API + worker.
# URL-encode special characters in passwords (or generate hex passwords).
# Managed databases: append ?sslmode=require (or verify-full with the provider CA).
# -----------------------------------------------------------------------------
# [PROD-REQUIRED] [SECRET]
DATABASE_URL=postgresql://typease_app:app_dev_pw@127.0.0.1:5432/typease
# [PROD-REQUIRED] [SECRET]
DATABASE_SYSTEM_URL=postgresql://typease_system:system_dev_pw@127.0.0.1:5432/typease
# migration job only [SECRET]
DATABASE_MIGRATION_URL=postgresql://typease_owner:owner_dev_pw@127.0.0.1:5432/typease
# Connections PER POOL. The API and the worker each open two pools (app + system), so one
# process uses up to 2 x DATABASE_POOL_MAX connections. See docs/deployment/scaling.md.
DATABASE_POOL_MAX=10
# redis://[user:password@]host:port[/db]   (rediss:// for TLS).                [PROD-REQUIRED]
# Rate limiting, caches and the BullMQ job queue. Needs maxmemory-policy noeviction.
REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# Secrets                                             scripts/generate-secrets.sh prints a fresh set
# -----------------------------------------------------------------------------
# In production the API refuses to start unless every secret below is a GENERATED value: not one of the
# published development values (this file, the docker dev files, the test setup), not a placeholder or a
# typed phrase ("change-me", "password", "0123456789" ...), random enough (about 100 bits by character
# statistics, at least 10 different characters), and different from every other secret.
#
# Signs access tokens. At least 32 characters.   openssl rand -base64 48     [PROD-REQUIRED] [SECRET]
JWT_ACCESS_SECRET=local-development-jwt-secret-0123456789abcdef
# Access token lifetime (seconds) and refresh token lifetime (days).
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# 32 random bytes, base64.   openssl rand -base64 32                         [PROD-REQUIRED] [SECRET]
# Encrypts identity numbers, MFA secrets, integration credentials and (local driver) files.
# LOSING IT MAKES THAT DATA UNRECOVERABLE: escrow it separately from the database backups.
# Production: must decode to 32 bytes that are not printable text (a key somebody typed is refused).
DATA_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQta2V5LTMyLWJ5dGVzISE=
# Name of DATA_ENCRYPTION_KEY (letters, digits, "-", "_"). It is stamped on everything that is encrypted,
# so the API knows which key reads which data. Default k1. Change it ONLY together with the key, as part
# of a rotation (docs/deployment/secrets.md): the new key gets a new id, the previous pair moves to
# DATA_ENCRYPTION_OLD_KEYS.
DATA_ENCRYPTION_KEY_ID=k1
# Key rotation: previous keys kept for DEcryption only, "id:base64,id:base64". Usually empty.
# Example after one rotation from k1 to k2:  DATA_ENCRYPTION_OLD_KEYS=k1:<the old base64 key>
# Remove an entry only after `pnpm --filter @typease/api reencrypt` reports nothing left under that id.
# Checked at every start, in every environment: each entry is "id:base64 of 32 bytes", ids are unique,
# and the id of the current key may not be listed with a different key. Old keys must be real keys too.
DATA_ENCRYPTION_OLD_KEYS=
# Keyed hash for blind indexes and signed URLs. At least 32 characters.      [PROD-REQUIRED] [SECRET]
# Changing it invalidates outstanding signed links and breaks lookups by blind index.
HMAC_KEY=local-development-hmac-key-0123456789abcdef
# true = refresh cookies only over HTTPS. Must be true in production.         [PROD-REQUIRED]
COOKIE_SECURE=false
# Optional cookie Domain attribute (e.g. .typease.ae). Leave empty: the cookie is then
# bound to the API host, which is the safest choice.
# COOKIE_DOMAIN=

# -----------------------------------------------------------------------------
# Authentication policy
# -----------------------------------------------------------------------------
# required | optional. "required": privileged roles must enrol in two-step verification.
# Must be "required" in production.                                           [PROD-REQUIRED]
MFA_ENFORCEMENT=optional
# Failed sign-ins before an account is locked, and for how long (minutes).
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Minimum length of every password that is set (sign-up, invitation, reset, change). 10 to 128; it can
# only raise the floor of 10 that the applications validate. The apps read the value from the public
# tenant configuration (passwordPolicy.minLength).
PASSWORD_MIN_LENGTH=10
# Lifetime of one-time codes (seconds).
OTP_TTL_SECONDS=300
# DEVELOPMENT ONLY: returns OTP codes and email tokens in API responses so flows work
# without providers. Must be false in production (the API refuses to start otherwise).
EXPOSE_DEV_TOKENS=true
# false = centres can only be created by a platform admin.
SELF_SIGNUP_ENABLED=true
# true = a new centre stays pending until a platform admin approves it.
TENANT_APPROVAL_REQUIRED=false
# true = owners must verify their phone by SMS during onboarding (needs an SMS provider).
ONBOARDING_REQUIRE_PHONE_VERIFICATION=false

# -----------------------------------------------------------------------------
# Rate limiting (Redis)
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
# bullmq = jobs go to Redis and are executed by the worker service (production).
# inline = jobs stay in the API's memory (tests, demos).
QUEUE_DRIVER=inline
# Only with QUEUE_DRIVER=inline: the API itself runs queued jobs and interval schedules
# ("single-process mode": no worker needed; jobs are lost on restart; cron schedules run hourly).
QUEUE_INLINE_AUTORUN=true

# -----------------------------------------------------------------------------
# Worker (services/worker; implemented in services/api/src/worker.ts). It reads the same
# environment as the API and needs QUEUE_DRIVER=bullmq.
# -----------------------------------------------------------------------------
# Jobs processed in parallel by one worker process.
WORKER_CONCURRENCY=5
# Port of its health endpoint: GET /health (ready), /health/live.
WORKER_HEALTH_PORT=4100
# Safety-net interval of the outbox dispatcher (milliseconds).
WORKER_OUTBOX_INTERVAL_MS=10000
# How long running jobs may finish after SIGTERM (milliseconds). Keep the container's stop
# grace period above it.
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# How often (seconds, 5 to 300) the process that runs the jobs - the worker, or the API in
# single-process mode - writes its heartbeat to Redis. The platform console (System status)
# calls the worker STALE after two intervals without one. Set the same value for API and worker.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15

# -----------------------------------------------------------------------------
# Object storage
# -----------------------------------------------------------------------------
# s3 = any S3-compatible private bucket (production).   local = encrypted files on disk.
STORAGE_DRIVER=local
# Directory of the local driver (and of public assets with the local driver).
STORAGE_LOCAL_DIR=./storage-data
# S3 endpoint URL. Leave empty for AWS S3. It appears in presigned URLs, so BROWSERS must be
# able to reach exactly this URL (HTTPS in production).
# With `docker compose --profile deps`:  S3_ENDPOINT=http://localhost:9000
# S3_ENDPOINT=
S3_REGION=me-central-1
# Private documents bucket: block all public access; lifecycle rule expiring incoming/ after 1 day.
S3_BUCKET=typease-documents
# Public assets bucket (logos, favicons): anonymous read. NEVER the same bucket as S3_BUCKET.
S3_PUBLIC_ASSETS_BUCKET=typease-public-assets
# Optional CDN / public URL of that bucket (bare https URL). Unset: the API streams brand assets itself.
# S3_PUBLIC_ASSETS_BASE_URL=
# Required for STORAGE_DRIVER=s3 unless the process has an IAM role (AWS_ROLE_ARN).  [SECRET]
# Dev MinIO application user:  typease-dev-app / typease-dev-app-secret-key
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# true for MinIO and most S3-compatible stores; false for AWS virtual-hosted style.
S3_FORCE_PATH_STYLE=true
# Upload limit in bytes (15 MiB). Keep the reverse proxy limit (UPLOAD_MAX_BODY) above it.
UPLOAD_MAX_BYTES=15728640
UPLOAD_ALLOWED_MIME=application/pdf,image/jpeg,image/png,image/webp
# Lifetime of presigned download / upload links (seconds).
DOWNLOAD_URL_TTL_SECONDS=120
UPLOAD_URL_TTL_SECONDS=600

# -----------------------------------------------------------------------------
# Malware scanning
# -----------------------------------------------------------------------------
# clamav = stream every upload to clamd.  none = uploads are marked SKIPPED (never CLEAN).
MALWARE_SCANNER=none
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# true = a file can only be downloaded after a CLEAN result. Recommended in production
# together with MALWARE_SCANNER=clamav. Never combine true with MALWARE_SCANNER=none.
REQUIRE_CLEAN_SCAN=false

# -----------------------------------------------------------------------------
# Platform default notification providers (each centre may configure its own in the console)
# -----------------------------------------------------------------------------
# smtp | log. "log" only writes the message to the log (nothing is delivered).
# With `docker compose --profile deps` (Mailpit): MAIL_DRIVER=smtp SMTP_HOST=localhost SMTP_PORT=1025
MAIL_DRIVER=log
# SMTP_HOST=
SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS when the server offers it.
SMTP_SECURE=false
# SMTP_USER=
# [SECRET]
# SMTP_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@typease.localhost
MAIL_FROM_NAME=TypEase
# twilio | http | log
SMS_DRIVER=log
# With SMS_DRIVER=http: POST {to, body} with a bearer token to this HTTPS URL.
# SMS_HTTP_URL=
# [SECRET]
# SMS_HTTP_TOKEN=
# With SMS_DRIVER=twilio:
# TWILIO_ACCOUNT_SID=
# [SECRET]
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# meta | log   (WhatsApp Business Cloud API)
WHATSAPP_DRIVER=log
# WHATSAPP_PHONE_NUMBER_ID=
# [SECRET]
# WHATSAPP_ACCESS_TOKEN=
# fcm | log    (push notifications of the mobile app)
PUSH_DRIVER=log
# FCM_PROJECT_ID=
# The service-account JSON on ONE line.                                      [SECRET]
# FCM_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------------------
# AI document assistant / OCR
# -----------------------------------------------------------------------------
# disabled | tesseract (bundled, English) | external-http
OCR_PROVIDER=disabled
# OCR_EXTERNAL_URL=
# [SECRET]
# OCR_EXTERNAL_TOKEN=
# Cost per page recorded for usage reports (decimal).
OCR_COST_PER_PAGE=0

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
# TEST adapter: no money moves. Must be false in production (the API refuses to start).
PAYMENT_SANDBOX_ENABLED=true
PAYMENT_SANDBOX_WEBHOOK_SECRET=sandbox-webhook-secret-change-me
# Platform gateway for SUBSCRIPTION invoices (each centre configures its own gateway for
# customer payments in the console). Webhook URLs to register at the gateway:
#   <API_PUBLIC_URL>/api/v1/public/webhooks/subscriptions/stripe   (platform account)
#   <API_PUBLIC_URL>/api/v1/public/webhooks/payments/stripe        (each centre's account)
# [SECRET]
# STRIPE_SECRET_KEY=
# [SECRET]
# STRIPE_WEBHOOK_SECRET=
# Webhooks older than this are rejected (replay protection).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# -----------------------------------------------------------------------------
# Automation (n8n) and outbound calls
# -----------------------------------------------------------------------------
# Base URL of n8n webhooks as reachable FROM THE API, e.g. http://n8n:5678/webhook
# N8N_WEBHOOK_BASE_URL=
# Shared secret used to sign calls to n8n.   openssl rand -base64 32          [SECRET]
# N8N_WEBHOOK_SECRET=
# Hosts that tenant-configured integrations may call, comma separated. Everything else is
# blocked (SSRF protection). Hosts listed here may be private and may use plain http.
OUTBOUND_WEBHOOK_ALLOWED_HOSTS=

# -----------------------------------------------------------------------------
# Internal
# -----------------------------------------------------------------------------
# Shared secret (header x-internal-token) for GET /api/v1/internal/metrics. At least 16
# characters; in production a generated value of at least 24.   openssl rand -base64 32   [PROD-REQUIRED] [SECRET]
# The reverse proxy blocks /api/v1/internal/* from the outside in any case.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# =============================================================================
# NOT part of env.ts - read by other programs
# (services/api/test/env-drift.spec.ts fails when a variable of env.ts is missing above, or when a
#  variable above this line is not in env.ts. DATABASE_MIGRATION_URL is the one documented exception.)
# =============================================================================
# Set instead of an access key pair when the process runs with an AWS IAM role.
# AWS_ROLE_ARN=
# The migration runner only accepts --reset when this is "true" and NODE_ENV is not
# production. Never set it on a server.
# ALLOW_DB_RESET=true
# Development / tests only: load a subset of API modules. Never set it in production.
# TYPEASE_MODULES=
# Air-gapped builds only (prisma generate without downloading the schema engine).
# PRISMA_SCHEMA_ENGINE_BINARY=/bin/true
# Backups: see infrastructure/deployment/env/backup.env.example (BACKUP_DIR, BACKUP_AGE_RECIPIENTS ...).
